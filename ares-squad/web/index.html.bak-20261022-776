<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0d1a12">
<title>末日小队 Ares Squad (H5原型)</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;font-family:"Courier New","Consolas","PingFang SC","Microsoft YaHei",monospace;background:#0d1a12;color:#e8f0e8;overflow:hidden;touch-action:manipulation;overscroll-behavior:none}
  #app{max-width:520px;margin:0 auto;height:100%;display:flex;flex-direction:column;padding:8px calc(6px + env(safe-area-inset-left)) calc(8px + env(safe-area-inset-bottom));gap:6px}
  .hud{display:flex;gap:5px;flex-wrap:wrap;align-items:center}
  .chip{background:#16261c;border:2px solid #2f4f3a;padding:5px 8px;font-size:11px;display:flex;align-items:center;gap:4px}
  .chip b{color:#ffd75a;font-size:13px;font-weight:900}
  .chip.army b{color:#8ce6a0}
  button{cursor:pointer;user-select:none;background:#2f5f3a;border:2px solid #4f8f5f;color:#fff;font-weight:700;letter-spacing:.5px;padding:6px 10px;font-size:12px;box-shadow:inset 1px 1px 0 rgba(255,255,255,.18),inset -1px -2px 0 rgba(0,0,0,.4),0 3px 0 0 #08120a;transition:transform .05s}
  button:active{transform:translateY(2px)}
  button:disabled{opacity:.35;cursor:not-allowed;box-shadow:none;transform:none}
  button.ghost{background:#16261c;border-color:#2f4f3a;color:#cfe0cf}
  #stage{flex:1;position:relative;background:#0a1410;border:2px solid #2f4f3a;overflow:hidden}
  #stage .cv-wrap{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#0a1410}
  #cv{image-rendering:pixelated;touch-action:none;background:#0a1410}
  .view-tag{position:absolute;top:6px;left:6px;background:#0a1410;border:2px solid #2f4f3a;padding:3px 8px;font-size:11px;font-weight:900;z-index:5}
  #battleBar{position:absolute;bottom:0;left:0;right:0;display:none;gap:5px;padding:5px;z-index:6;background:linear-gradient(180deg,transparent,rgba(6,12,8,.92) 35%)}
  #battleBar button{flex:1;font-size:11px}
  #missionBanner{position:absolute;top:34px;left:50%;transform:translateX(-50%);background:#16261c;border:2px solid #4f8f5f;padding:5px 12px;font-size:12px;font-weight:900;z-index:5;display:none}
  #campPanel{position:absolute;inset:0;display:none;flex-direction:column;gap:6px;padding:38px 6px 6px;background:#0a1410;overflow-y:auto;z-index:4;-webkit-overflow-scrolling:touch}
  #campPanel h2{color:#8ce6a0;font-size:14px;font-weight:900;letter-spacing:1px}
  .camp-sec{background:#101f16;border:2px solid #2f4f3a;padding:8px;font-size:11px}
  .camp-sec h3{color:#ffd75a;font-size:12px;font-weight:900;margin-bottom:5px}
  .bld-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}
  .bld{background:#16261c;border:2px solid #2f4f3a;padding:6px 5px;cursor:pointer;position:relative;min-height:64px;font-size:10px}
  .bld.built{border-color:#4f8f5f;background:#0e2014}
  .bld .lv{position:absolute;top:3px;right:4px;background:#ffd75a;color:#3a2a00;padding:1px 4px;font-weight:900;font-size:9px}
  .bld .nm{font-weight:900;font-size:11px;margin-bottom:2px}
  .bld .cost{color:#ffd75a;font-size:9px}
  .bld.empty{border-style:dashed;opacity:.85}
  .crew-row{display:flex;gap:5px;flex-wrap:wrap}
  .crew{background:#16261c;border:2px solid #2f4f3a;padding:5px;font-size:10px;flex:1;min-width:90px}
  .crew .nm{font-weight:900;font-size:11px;color:#8ce6a0}
  .crew .bar{height:6px;background:#0a1410;margin-top:3px}
  .crew .bar i{display:block;height:100%;background:#37a3ff}
  .crew .bar.mor i{background:#8ce6a0}
  .crew .st{margin-top:3px;color:#7f95c9;font-size:9px}
  .make-row{display:flex;gap:5px;flex-wrap:wrap}
  .make{background:#16261c;border:2px solid #2f4f3a;padding:5px;font-size:10px;flex:1;min-width:110px;cursor:pointer}
  .make .nm{font-weight:900;font-size:11px}
  .make .cost{color:#ffd75a;font-size:9px}
  .ev-line{background:#0a1410;border:2px solid #2f4f3a;padding:5px 8px;font-size:11px;min-height:30px}
  .ev-line.good{border-color:#4f8f5f;color:#8ce6a0}
  .ev-line.bad{border-color:#8f4f4f;color:#ff9f9f}
  .ev-line.mix{border-color:#8f8a4f;color:#ffd75a}
  #resultOverlay{position:absolute;inset:0;background:rgba(6,12,8,.9);display:none;align-items:center;justify-content:center;z-index:9}
  #resultBox{background:#101f16;border:2px solid #4f8f5f;padding:16px;font-size:12px;text-align:center;max-width:88%;line-height:1.7}
  #resultBox h2{color:#ffd75a;font-size:16px;margin-bottom:6px;font-weight:900}
  #resultBox .lose{color:#ff9f9f}
  #onboard{position:absolute;inset:0;background:rgba(6,12,8,.94);display:none;align-items:center;justify-content:center;z-index:99}
  #onboard .box{background:#101f16;border:2px solid #4f8f5f;padding:16px;max-width:88%;font-size:12px;line-height:1.7;text-align:center}
  #onboard h1{color:#8ce6a0;font-size:16px;margin-bottom:8px;font-weight:900;letter-spacing:1px}
  #toast{position:absolute;top:44px;left:50%;transform:translateX(-50%);background:#ffd75a;color:#3a2a00;font-weight:900;padding:6px 14px;font-size:12px;border:2px solid #08120a;z-index:98;display:none;animation:toastIn 2.4s ease forwards}
  @keyframes toastIn{0%{opacity:0;transform:translateX(-50%) translateY(-14px)}10%{opacity:1;transform:translateX(-50%) translateY(0)}80%{opacity:1}100%{opacity:0;transform:translateX(-50%) translateY(-8px)}}
  #saveBar{display:flex;gap:5px}
  #saveBar button{flex:1}
  .hint{font-size:10px;color:#7f95c9;line-height:1.5;padding:4px 6px;background:#0a1410;border:2px solid #2f4f3a}
</style>
</head>
<body>
<div id="app">
  <div class="hud">
    <div class="chip">💰<b id="hGold">0</b></div>
    <div class="chip">🔩<b id="hPart">0</b></div>
    <div class="chip">🍖<b id="hFood">0</b></div>
    <div class="chip">💊<b id="hMed">0</b></div>
  </div>
  <div id="stage">
    <div class="cv-wrap"><canvas id="cv"></canvas></div>
    <div class="view-tag" id="viewTag">营地 · 前哨</div>
    <div id="missionBanner"></div>
    <div id="battleBar">
      <button id="btnGrenade">🧨 手雷</button>
      <button id="btnRacket">🚀 火箭</button>
      <button id="btnPause" class="ghost">⏸</button>
    </div>
    <div id="campPanel">
      <h2>🏕 前哨营地</h2>
      <div class="camp-sec">
        <h3>🏗 建筑 (点击建造/升级)</h3>
        <div class="bld-grid" id="bldGrid"></div>
      </div>
      <div class="camp-sec">
        <h3>🪖 小队 (出战配置)</h3>
        <div class="crew-row" id="crewRow"></div>
        <div style="margin-top:6px"><button class="ghost" id="btnWeapon" style="width:100%">🔫 切换武器: <b id="wName">M9步枪</b></button></div>
      </div>
      <div class="camp-sec">
        <h3>🔧 工坊制作</h3>
        <div class="make-row" id="makeRow"></div>
      <button class="ghost" id="btnHeal" style="width:100%;margin-top:5px">💊 医疗站: 全小队治愈 (耗1医疗包)</button>
      </div>
      <div class="ev-line" id="evLine">—</div>
      <div class="hint" id="campHint"></div>
      <button id="btnDeploy" style="width:100%;margin-top:4px;font-size:13px">🚁 出击: 任务 <b id="mName">1</b></button>
    </div>
    <div id="resultOverlay"><div id="resultBox"></div></div>
    <div id="onboard"><div class="box">
      <h1>末日小队 Ares Squad</h1>
      病毒"阿瑞斯"爆发,你是S.O.T小队指挥官尼奥。<br><br>
      <b>营地</b>:建建筑、做装备、养士气、攒资源<br>
      <b>任务</b>:点击地图移动士兵、点敌人攻击、用🧨/🚀特殊技能<br><br>
      带回来的资源让营地更强,再推更深的地块!
      <div style="margin-top:10px"><button id="btnStart" style="font-size:14px">▶ 开始指挥</button></div>
    </div></div>
    <div id="toast"></div>
  </div>
  <div id="saveBar">
    <button class="ghost" id="btnSave">💾 存档</button>
    <button class="ghost" id="btnReset">↺ 重开</button>
  </div>
</div>
<script>
"use strict";
/* ==================== 常量 ==================== */
const COLS=24, ROWS=14, CELL=40;
const VIEW_W=COLS*CELL, VIEW_H=ROWS*CELL;
// 战场世界比视口宽(2×视口), 摄像机跟随小队
const WORLD_W=VIEW_W*2, WORLD_H=VIEW_H;
const BUILDINGS=[
  {id:"barracks",nm:"兵营",icon:"🏠",cost:[120,260,500],desc:"士兵上限+1 / 士气上限+10"},
  {id:"workshop",nm:"工坊",icon:"🔧",cost:[150,300,600],desc:"解锁制作/零件产出+20%"},
  {id:"kitchen",nm:"厨房",icon:"🍳",cost:[100,220,440],desc:"食物上限+15 / 每日食物+3"},
  {id:"medbay",nm:"医疗站",icon:"💊",cost:[180,360,720],desc:"治疗伤病 / 医疗包产出"},
  {id:"wall",nm:"围墙",icon:"🧱",cost:[130,260,520],desc:"尸潮防守强度+30%"},
  {id:"radio",nm:"电台",icon:"📡",cost:[160,320,640],desc:"解锁下一任务情报"}
];
const CREO_DEF=[
  {nm:"步兵",hp:320,atk:20,rate:11,range:220,icon:"🪖"},
  {nm:"机枪手",hp:240,atk:17,rate:5,range:320,icon:"🔫"},
  {nm:"狙击手",hp:180,atk:52,rate:34,range:500,icon:"🎯"}
];
const WEAPONS=[
  {id:"m9",nm:"M9步枪",atk:1,desc:"均衡"},
  {id:"snipe",nm:"狙击弹",atk:1.8,desc:"狙击手专属强化"},
  {id:"med",nm:"医疗包",atk:0.9,desc:"战场回血"}
];
const MAKES=[
  {id:"snipe",nm:"狙击弹",part:3,gold:40,need:"workshop",desc:"狙击手×1.6"},
  {id:"med",nm:"医疗包",part:2,gold:30,need:"medbay",desc:"战斗中恢复30血"},
  {id:"boost",nm:"步枪强化",part:4,gold:60,need:"workshop",desc:"全体攻+20%"}
];
const MISSIONS=[
  {id:1,nm:"清剿感染区",type:"annihilate",desc:"消灭全部感染者",enemies:[{t:"walker",n:3,r:[5,10]},{t:"fatty",n:1,r:[5,12]}],reward:{gold:140,part:3,food:4,med:1},boss:false},
  {id:2,nm:"护送幸存者",type:"escort",desc:"护送平民穿过走廊",enemies:[{t:"walker",n:6,r:[3,11]},{t:"fatty",n:2,r:[4,12]}],reward:{gold:200,part:4,food:5,med:1},boss:false},
  {id:3,nm:"尸潮夜袭",type:"annihilate",desc:"守住,消灭僵尸王!",enemies:[{t:"walker",n:7,r:[4,12]},{t:"fatty",n:3,r:[4,12]},{t:"king",n:1,r:[12,3]}],reward:{gold:340,part:6,food:6,med:2},boss:true}
];
const ENEMY_DEF={
  walker:{hp:12,atk:1,speed:40,range:140,icon:"🧟",color:"#7fae8f"},
  fatty:{hp:38,atk:3,speed:26,range:120,icon:"🧌",color:"#8f6f4f",armor:3},
  king:{hp:130,atk:7,speed:30,range:150,icon:"👹",color:"#8f4f6f",armor:7}
};
// 自动推进兵线: 士兵沿敌方来袭方向(x+)推进到射程内
function advancePos(s,d){
  // 朝右侧(敌人来袭方向)推进 射程的 0.9 倍
  const tx=Math.min(VIEW_W-CELL*1.2, s.x + d.range*0.9);
  return {x:tx, y:s.y};
}
/* ==================== 状态 ==================== */
let S=null, view="camp", paused=false, inBattle=false, spawnQueue=[], battleT=0, spawnTimer=0, civ=null, lastSave=0, offT=0;
let tapMarker=null;      // {x,y,life} 点击涟漪反馈
let camX=0, camY=0;      // 摄像机(跟随视角), 世界坐标
let bldRects=[];         // 营地建筑槽位(世界坐标), 供画布点击
function newState(){
  return {
    gold:160,part:2,food:14,med:0,
    bld:{barracks:1,workshop:0,kitchen:0,medbay:0,wall:0,radio:0},
    crew:[{type:0,hp:130,mor:100,wep:"m9"},{type:1,hp:90,mor:100,wep:"m9"},{type:2,hp:70,mor:100,wep:"m9"}],
    crewMax:3,
    mission:1, won:0,
    weapon:"m9",
    day:1,
    offlineMax:8*3600*1000
  };
}
/* ==================== 存档 ==================== */
const LS_KEY="ares_squad_v1";
function save(){
  if(paused) paused=false;
  try{ localStorage.setItem(LS_KEY,JSON.stringify({S,offT:0,ts:Date.now()})); toast("已存档"); }catch(e){}
  lastSave=Date.now(); offT=0;
}
function load(){
  let d=null;
  try{ d=JSON.parse(localStorage.getItem(LS_KEY)||"null"); }catch(e){}
  if(d && d.S){ S=d.S; offT=d.offT||0; lastSave=d.ts||Date.now(); }
}
function resetAll(){ localStorage.removeItem(LS_KEY); location.reload(); }
/* 测试钩子: 重置为新存档(不清 localStorage) */
function __resetSave(){ S=newState(); lastSave=Date.now(); offT=0; view="camp"; inBattle=false; }
/* ==================== 离线收益 ==================== */
function offlineGain(){
  let ms=Date.now()-lastSave; if(ms<60000) return;
  ms=Math.min(ms,S.offlineMax);
  let foodCap=bldLv("kitchen")*15+10, partRate=bldLv("workshop");
  const g=Math.floor(ms/3600*1000);
  S.food=Math.min(foodCap,S.food+g*0.6|0);
  S.part+=partRate*g*0.4;
  S.gold+=12*partRate+g*0.3;
  return g;
}
function bldLv(id){ return S.bld[id]||0; }
/* ==================== 提示 ==================== */
let toastT=null;
function toast(msg){ const t=document.getElementById("toast"); t.textContent=msg; t.style.display="block"; t.style.animation="none"; void t.offsetWidth; t.style.animation=""; clearTimeout(toastT); toastT=setTimeout(()=>t.style.display="none",2400); }
/* ==================== 营地渲染 (DOM) ==================== */
function refreshHud(){
  document.getElementById("hGold").textContent=Math.floor(S.gold);
  document.getElementById("hPart").textContent=Math.floor(S.part);
  document.getElementById("hFood").textContent=Math.floor(S.food);
  document.getElementById("hMed").textContent=S.med;
}
function bldLayout(){
  const bpos={barracks:[4,3],workshop:[8,3],kitchen:[12,3],medbay:[16,3],wall:[19,3],radio:[22,3]};
  const out=[];
  BUILDINGS.forEach(b=>{
    const p=bpos[b.id];
    out.push({id:b.id,x:p[0]*CELL,y:VIEW_H-CELL*2,w:CELL*1.6,h:CELL*1.6});
  });
  return out;
}
function renderCamp(){
  view="camp";
  bldRects=bldLayout();
  document.getElementById("viewTag").textContent="营地 · 前哨";
  document.getElementById("campPanel").style.display="flex";
  document.getElementById("battleBar").style.display="none";
  document.getElementById("missionBanner").style.display="none";
  const grid=document.getElementById("bldGrid"); grid.innerHTML="";
  BUILDINGS.forEach(b=>{
    const lv=S.bld[b.id]||0;
    const el=document.createElement("div");
    el.className="bld"+(lv>0?" built":" empty");
    const next=b.cost[lv];
    el.innerHTML=(lv>0?'<span class="lv">Lv'+lv+'</span>':'')+'<div class="nm">'+b.icon+' '+b.nm+'</div>'+
      (next!=null?'<div class="cost">'+(lv===0?"建": "升")+' 💰'+next+'</div><div style="color:#7f95c9">'+b.desc+'</div>':'<div class="cost" style="color:#7f95c9">已满级</div>');
    el.onclick=()=>{
      if(next==null){ toast("已满级"); return; }
      if(S.gold<next){ toast("金币不足,需💰"+next); return; }
      S.gold-=next; S.bld[b.id]=lv+1;
      if(b.id==="barracks"){ S.crewMax=lv+2; addCrew(lv); }
      if(b.id==="kitchen"){ }
      refreshHud(); renderCamp(); toast(b.nm+(lv===0?"已建成":"升至Lv"+(lv+1)));
    };
    grid.appendChild(el);
  });
  // 小队
  const row=document.getElementById("crewRow"); row.innerHTML="";
  S.crew.forEach((c,i)=>{
    const d=CREO_DEF[c.type];
    const el=document.createElement("div"); el.className="crew";
    const hpPct=Math.max(0,Math.min(100,c.hp/d.hp*100));
    const morPct=Math.max(0,Math.min(100,c.mor));
    el.innerHTML='<div class="nm">'+d.icon+' '+d.nm+' <span style="color:#7f95c9">Lv'+(S.won+1)+'</span></div>'+
      '<div class="bar"><i style="width:'+hpPct+'%"></i></div>'+
      '<div class="bar mor"><i style="width:'+morPct+'%"></i></div>'+
      '<div class="st">🔫'+(WEAPONS.find(w=>w.id===c.wep)||{}).nm||"M9步枪"+'</div>';
    row.appendChild(el);
  });
  document.getElementById("wName").textContent=(WEAPONS.find(w=>w.id===S.weapon)||{}).nm||"";
  // 制作
  const mk=document.getElementById("makeRow"); mk.innerHTML="";
  MAKES.forEach(mk0=>{
    const el=document.createElement("div"); el.className="make";
    const ok = S.part>=mk0.part && S.gold>=mk0.gold && bldLv(mk0.need)>0;
    el.innerHTML='<div class="nm">'+mk0.nm+'</div><div class="cost">🔩'+mk0.part+' 💰'+mk0.gold+(bldLv(mk0.need)===0?" · 需"+BUILDINGS.find(b=>b.id===mk0.need).nm:"")+'</div><div style="color:#7f95c9">'+mk0.desc+'</div>';
    el.onclick=()=>{
      if(bldLv(mk0.need)===0){ toast("需先建造"+BUILDINGS.find(b=>b.id===mk0.need).nm); return; }
      if(S.part<mk0.part){ toast("零件不足"); return; }
      if(S.gold<mk0.gold){ toast("金币不足"); return; }
      S.part-=mk0.part; S.gold-=mk0.gold;
      if(mk0.id==="med"){ S.med+=1; toast("医疗包+1"); }
      else if(mk0.id==="boost"){ S.crew.forEach(c=>c.mor=Math.min(120,c.mor+15)); toast("步枪强化:士气+15"); }
      else { S.weapon="snipe"; toast("狙击弹已装备"); }
      refreshHud(); renderCamp();
    };
    mk.appendChild(el);
  });
  // 事件
  const ev=document.getElementById("evLine");
  if(S.food<3){ ev.className="ev-line bad"; ev.textContent="⚠ 食物告急!士气将持续下降,建厨房或完成任务补粮"; }
  else if(S.won===2 && S.mission===3){ ev.className="ev-line mix"; ev.textContent="📡 电台:检测到僵尸王活动,尸潮夜袭任务已开放"; }
  else if(S.crew.some(c=>c.hp<CREO_DEF[c.type].hp*0.4)){ ev.className="ev-line bad"; ev.textContent="🏥 有士兵带伤,建议医疗站治疗后再出击"; }
  else { ev.className="ev-line"; ev.textContent="✅ 营地运转正常,可以出击了"; }
  // 提示
  document.getElementById("campHint").textContent=hintLine();
  document.getElementById("mName").textContent=missionName();
  document.getElementById("btnDeploy").disabled = S.mission>3;
  // 背景画静态营地
  drawCampStatic();
}
function missionLabel(){ if(S.mission>3) return "4+"; return S.mission; }
function missionName(){ if(S.mission>3) return "已通关"; return MISSIONS[S.mission-1].nm; }
function hintLine(){
  if(S.food<3) return "优先建厨房/完成任务补食物";
  if(bldLv("workshop")===0) return "建议先建工坊,解锁制作系统";
  if(S.part>=3 && S.gold>=40 && bldLv("workshop")>0) return "可以制作狙击弹了";
  if(S.crew.length<3 && bldLv("barracks")<3) return "升级兵营扩充小队";
  return "出击获取资源,回营地升级建筑";
}
function addCrew(idx){
  const t=[0,1,2][Math.min(idx,2)]||0;
  if(S.crew.length>=4) return;
  S.crew.push({type:t,hp:CREO_DEF[t].hp,mor:100,wep:"m9"});
}

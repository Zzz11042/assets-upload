function onBattleTap(e){
  if(e.cancelable) e.preventDefault();
  if(!inBattle) return;
  if(paused){ paused=false; const bp=document.getElementById("btnPause"); if(bp) bp.textContent="⏸"; }
  const p=cvPos(e);
  if(!p) return;
  tapMarker={x:p.x,y:p.y,life:0.5};
  // 点敌人 → 指定攻击(扩大判定半径)
  let hit=null,best=1e9;
  enemies.forEach(en=>{ if(!en.alive)return; const dd=Math.hypot(en.x-p.x,en.y-p.y); if(dd<40&&dd<best){best=dd;hit=en;} });
  if(hit){
    let bs=null,bd=1e9;
    for(const s of soldiers){ if(!s.alive) continue; const d=Math.hypot(s.x-hit.x,s.y-hit.y); if(d<bd){bd=d;bs=s;} }
    if(bs){ bs.target=hit; bs.tx=hit.x; bs.ty=hit.y; }
    return;
  }
  // 点空地 → 最近士兵移动(目标钳制在镜头可视区内, 士兵不出屏)
  let bs=null,bd=1e9;
  for(const s of soldiers){ if(!s.alive) continue; const d=Math.hypot(s.x-p.x,s.y-p.y); if(d<bd){bd=d;bs=s;} }
  if(bs){
    const mx=Math.max(camX,Math.min(camX+VIEW_W,p.x));
    const my=Math.max(camY,Math.min(camY+VIEW_H,p.y));
    bs.tx=mx; bs.ty=my; bs.target=null;
  }
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0d1a12">
<title>末日小队 Ares Squad (H5原型)</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;font-family:"Courier New","Consolas","PingFang SC","Microsoft YaHei",monospace;background:#0d1a12;color:#e8f0e8;overflow:hidden;touch-action:manipulation;overscroll-behavior:none}
  #app{max-width:520px;margin:0 auto;height:100%;display:flex;flex-direction:column;padding:8px calc(6px + env(safe-area-inset-left)) calc(8px + env(safe-area-inset-bottom));gap:6px}
  .hud{display:flex;gap:5px;flex-wrap:wrap;align-items:center}
  .chip{background:#16261c;border:2px solid #2f4f3a;padding:5px 8px;font-size:11px;display:flex;align-items:center;gap:4px}
  .chip b{color:#ffd75a;font-size:13px;font-weight:900}
  .chip.army b{color:#8ce6a0}
  button{cursor:pointer;user-select:none;background:#2f5f3a;border:2px solid #4f8f5f;color:#fff;font-weight:700;letter-spacing:.5px;padding:6px 10px;font-size:12px;box-shadow:inset 1px 1px 0 rgba(255,255,255,.18),inset -1px -2px 0 rgba(0,0,0,.4),0 3px 0 0 #08120a;transition:transform .05s}
  button:active{transform:translateY(2px)}
  button:disabled{opacity:.35;cursor:not-allowed;box-shadow:none;transform:none}
  button.ghost{background:#16261c;border-color:#2f4f3a;color:#cfe0cf}
  #stage{flex:1;position:relative;background:#0a1410;border:2px solid #2f4f3a;overflow:hidden}
  #stage .cv-wrap{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#0a1410}
  #cv{image-rendering:pixelated;touch-action:none;background:#0a1410}
  .view-tag{position:absolute;top:6px;left:6px;background:#0a1410;border:2px solid #2f4f3a;padding:3px 8px;font-size:11px;font-weight:900;z-index:5}
  #battleBar{position:absolute;bottom:0;left:0;right:0;display:none;gap:5px;padding:5px;z-index:6;background:linear-gradient(180deg,transparent,rgba(6,12,8,.92) 35%)}
  #battleBar button{flex:1;font-size:11px}
  #missionBanner{position:absolute;top:34px;left:50%;transform:translateX(-50%);background:#16261c;border:2px solid #4f8f5f;padding:5px 12px;font-size:12px;font-weight:900;z-index:5;display:none}
  #campPanel{position:absolute;inset:0;display:none;flex-direction:column;gap:6px;padding:38px 6px 6px;background:#0a1410;overflow-y:auto;z-index:4;-webkit-overflow-scrolling:touch}
  #campPanel h2{color:#8ce6a0;font-size:14px;font-weight:900;letter-spacing:1px}
  .camp-sec{background:#101f16;border:2px solid #2f4f3a;padding:8px;font-size:11px}
  .camp-sec h3{color:#ffd75a;font-size:12px;font-weight:900;margin-bottom:5px}
  .bld-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}
  .bld{background:#16261c;border:2px solid #2f4f3a;padding:6px 5px;cursor:pointer;position:relative;min-height:64px;font-size:10px}
  .bld.built{border-color:#4f8f5f;background:#0e2014}
  .bld .lv{position:absolute;top:3px;right:4px;background:#ffd75a;color:#3a2a00;padding:1px 4px;font-weight:900;font-size:9px}
  .bld .nm{font-weight:900;font-size:11px;margin-bottom:2px}
  .bld .cost{color:#ffd75a;font-size:9px}
  .bld.empty{border-style:dashed;opacity:.85}
  .crew-row{display:flex;gap:5px;flex-wrap:wrap}
  .crew{background:#16261c;border:2px solid #2f4f3a;padding:5px;font-size:10px;flex:1;min-width:90px}
  .crew .nm{font-weight:900;font-size:11px;color:#8ce6a0}
  .crew .bar{height:6px;background:#0a1410;margin-top:3px}
  .crew .bar i{display:block;height:100%;background:#37a3ff}
  .crew .bar.mor i{background:#8ce6a0}
  .crew .st{margin-top:3px;color:#7f95c9;font-size:9px}
  .make-row{display:flex;gap:5px;flex-wrap:wrap}
  .make{background:#16261c;border:2px solid #2f4f3a;padding:5px;font-size:10px;flex:1;min-width:110px;cursor:pointer}
  .make .nm{font-weight:900;font-size:11px}
  .make .cost{color:#ffd75a;font-size:9px}
  .ev-line{background:#0a1410;border:2px solid #2f4f3a;padding:5px 8px;font-size:11px;min-height:30px}
  .ev-line.good{border-color:#4f8f5f;color:#8ce6a0}
  .ev-line.bad{border-color:#8f4f4f;color:#ff9f9f}
  .ev-line.mix{border-color:#8f8a4f;color:#ffd75a}
  #resultOverlay{position:absolute;inset:0;background:rgba(6,12,8,.9);display:none;align-items:center;justify-content:center;z-index:9}
  #resultBox{background:#101f16;border:2px solid #4f8f5f;padding:16px;font-size:12px;text-align:center;max-width:88%;line-height:1.7}
  #resultBox h2{color:#ffd75a;font-size:16px;margin-bottom:6px;font-weight:900}
  #resultBox .lose{color:#ff9f9f}
  #onboard{position:absolute;inset:0;background:rgba(6,12,8,.94);display:none;align-items:center;justify-content:center;z-index:99}
  #onboard .box{background:#101f16;border:2px solid #4f8f5f;padding:16px;max-width:88%;font-size:12px;line-height:1.7;text-align:center}
  #onboard h1{color:#8ce6a0;font-size:16px;margin-bottom:8px;font-weight:900;letter-spacing:1px}
  #toast{position:absolute;top:44px;left:50%;transform:translateX(-50%);background:#ffd75a;color:#3a2a00;font-weight:900;padding:6px 14px;font-size:12px;border:2px solid #08120a;z-index:98;display:none;animation:toastIn 2.4s ease forwards}
  @keyframes toastIn{0%{opacity:0;transform:translateX(-50%) translateY(-14px)}10%{opacity:1;transform:translateX(-50%) translateY(0)}80%{opacity:1}100%{opacity:0;transform:translateX(-50%) translateY(-8px)}}
  #saveBar{display:flex;gap:5px}
  #saveBar button{flex:1}
  .hint{font-size:10px;color:#7f95c9;line-height:1.5;padding:4px 6px;background:#0a1410;border:2px solid #2f4f3a}
</style>
</head>
<body>
<div id="app">
  <div class="hud">
    <div class="chip">💰<b id="hGold">0</b></div>
    <div class="chip">🔩<b id="hPart">0</b></div>
    <div class="chip">🍖<b id="hFood">0</b></div>
    <div class="chip">💊<b id="hMed">0</b></div>
  </div>
  <div id="stage">
    <div class="cv-wrap"><canvas id="cv"></canvas></div>
    <div class="view-tag" id="viewTag">营地 · 前哨</div>
    <div id="missionBanner"></div>
    <div id="battleBar">
      <button id="btnGrenade">🧨 手雷</button>
      <button id="btnRacket">🚀 火箭</button>
      <button id="btnPause" class="ghost">⏸</button>
    </div>
    <div id="campPanel">
      <h2>🏕 前哨营地</h2>
      <div class="camp-sec">
        <h3>🏗 建筑 (点击建造/升级)</h3>
        <div class="bld-grid" id="bldGrid"></div>
      </div>
      <div class="camp-sec">
        <h3>🪖 小队 (出战配置)</h3>
        <div class="crew-row" id="crewRow"></div>
        <div style="margin-top:6px"><button class="ghost" id="btnWeapon" style="width:100%">🔫 切换武器: <b id="wName">M9步枪</b></button></div>
      </div>
      <div class="camp-sec">
        <h3>🔧 工坊制作</h3>
        <div class="make-row" id="makeRow"></div>
      <button class="ghost" id="btnHeal" style="width:100%;margin-top:5px">💊 医疗站: 全小队治愈 (耗1医疗包)</button>
      </div>
      <div class="ev-line" id="evLine">—</div>
      <div class="hint" id="campHint"></div>
      <button id="btnDeploy" style="width:100%;margin-top:4px;font-size:13px">🚁 出击: 任务 <b id="mName">1</b></button>
    </div>
    <div id="resultOverlay"><div id="resultBox"></div></div>
    <div id="onboard"><div class="box">
      <h1>末日小队 Ares Squad</h1>
      病毒"阿瑞斯"爆发,你是S.O.T小队指挥官尼奥。<br><br>
      <b>营地</b>:建建筑、做装备、养士气、攒资源<br>
      <b>任务</b>:点击地图移动士兵、点敌人攻击、用🧨/🚀特殊技能<br><br>
      带回来的资源让营地更强,再推更深的地块!
      <div style="margin-top:10px"><button id="btnStart" style="font-size:14px">▶ 开始指挥</button></div>
    </div></div>
    <div id="toast"></div>
  </div>
  <div id="saveBar">
    <button class="ghost" id="btnSave">💾 存档</button>
    <button class="ghost" id="btnReset">↺ 重开</button>
  </div>
</div>
<script>
"use strict";
/* ==================== 常量 ==================== */
const COLS=24, ROWS=14, CELL=40;
const VIEW_W=COLS*CELL, VIEW_H=ROWS*CELL;
// 战场世界比视口宽(2×视口), 摄像机跟随小队
const WORLD_W=VIEW_W*2, WORLD_H=VIEW_H;
const BUILDINGS=[
  {id:"barracks",nm:"兵营",icon:"🏠",cost:[120,260,500],desc:"士兵上限+1 / 士气上限+10"},
  {id:"workshop",nm:"工坊",icon:"🔧",cost:[150,300,600],desc:"解锁制作/零件产出+20%"},
  {id:"kitchen",nm:"厨房",icon:"🍳",cost:[100,220,440],desc:"食物上限+15 / 每日食物+3"},
  {id:"medbay",nm:"医疗站",icon:"💊",cost:[180,360,720],desc:"治疗伤病 / 医疗包产出"},
  {id:"wall",nm:"围墙",icon:"🧱",cost:[130,260,520],desc:"尸潮防守强度+30%"},
  {id:"radio",nm:"电台",icon:"📡",cost:[160,320,640],desc:"解锁下一任务情报"}
];
const CREO_DEF=[
  {nm:"步兵",hp:320,atk:20,rate:11,range:220,icon:"🪖"},
  {nm:"机枪手",hp:240,atk:17,rate:5,range:320,icon:"🔫"},
  {nm:"狙击手",hp:180,atk:52,rate:34,range:500,icon:"🎯"}
];
const WEAPONS=[
  {id:"m9",nm:"M9步枪",atk:1,desc:"均衡"},
  {id:"snipe",nm:"狙击弹",atk:1.8,desc:"狙击手专属强化"},
  {id:"med",nm:"医疗包",atk:0.9,desc:"战场回血"}
];
const MAKES=[
  {id:"snipe",nm:"狙击弹",part:3,gold:40,need:"workshop",desc:"狙击手×1.6"},
  {id:"med",nm:"医疗包",part:2,gold:30,need:"medbay",desc:"战斗中恢复30血"},
  {id:"boost",nm:"步枪强化",part:4,gold:60,need:"workshop",desc:"全体攻+20%"}
];
const MISSIONS=[
  {id:1,nm:"清剿感染区",type:"annihilate",desc:"消灭全部感染者",enemies:[{t:"walker",n:3,r:[5,10]},{t:"fatty",n:1,r:[5,12]}],reward:{gold:140,part:3,food:4,med:1},boss:false},
  {id:2,nm:"护送幸存者",type:"escort",desc:"护送平民穿过走廊",enemies:[{t:"walker",n:6,r:[3,11]},{t:"fatty",n:2,r:[4,12]}],reward:{gold:200,part:4,food:5,med:1},boss:false},
  {id:3,nm:"尸潮夜袭",type:"annihilate",desc:"守住,消灭僵尸王!",enemies:[{t:"walker",n:7,r:[4,12]},{t:"fatty",n:3,r:[4,12]},{t:"king",n:1,r:[12,3]}],reward:{gold:340,part:6,food:6,med:2},boss:true}
];
const ENEMY_DEF={
  walker:{hp:12,atk:1,speed:40,range:140,color:"#7fae8f"},
  fatty:{hp:38,atk:3,speed:26,range:120,color:"#8f6f4f",armor:3},
  king:{hp:130,atk:7,speed:30,range:150,color:"#8f4f6f",armor:7}
};
/* ==================== 像素美术引擎(星露谷/泰拉瑞亚风) ====================
   思路: 程序化像素 sprite —— 离屏 canvas 逐像素绘制小图(12x14),
   主 canvas 关闭平滑 + 整数倍放大, 保持像素锐利。每色 3~4 档明度,
   左上光源高光 / 右下阴影, 深色轮廓强调剪影。 */
const SPRITE_SCALE=3;
function pxCan(w,h){ const c=document.createElement("canvas"); c.width=w; c.height=h; return c; }
function pxDraw(g,w,h){ g.imageSmoothingEnabled=false; return g; }
function makeSprite(w,h,fn){
  const c=pxCan(w,h); const g=c.getContext("2d"); pxDraw(g,w,h);
  fn(g,(px,py,col)=>{ g.fillStyle=col; g.fillRect(px,py,1,1); });
  return c;
}
// 通用像素小人模板: 参数化头盔色/身体色/腿/武器
function makeSoldier(base,accent,weapon){
  return makeSprite(12,16,(g,px)=>{
    const c="#1a1a1a";                 // 轮廓
    const skin="#e8c89a", skinD="#c8a878";
    const leg="#4a3a2a", legD="#3a2a1a";
    const boot="#2a2a2a";
    // 头(头盔)
    px(4,0,c);px(5,0,c);px(6,0,c);px(7,0,c);
    px(3,1,c);px(4,1,accent);px(5,1,accent);px(6,1,accent);px(7,1,accent);px(8,1,c);
    px(3,2,c);px(4,2,base);px(5,2,base);px(6,2,base);px(7,2,base);px(8,2,c);
    px(3,3,c);px(4,3,base);px(5,3,skin);px(6,3,skin);px(7,3,base);px(8,3,c);
    px(4,4,c);px(5,4,skinD);px(6,4,skinD);px(7,4,c);
    // 躯干
    px(3,5,c);px(4,5,base);px(5,5,base);px(6,5,base);px(7,5,base);px(8,5,c);
    px(3,6,c);px(4,6,base);px(5,6,accent);px(6,6,accent);px(7,6,base);px(8,6,c);
    px(3,7,c);px(4,7,base);px(5,7,base);px(6,7,base);px(7,7,base);px(8,7,c);
    // 手臂+武器
    px(2,6,c);px(9,6,c);
    px(2,7,c);px(9,7,c);
    if(weapon==="gun"){ px(8,6,boot);px(9,6,boot);px(10,6,boot); }
    if(weapon==="snipe"){ px(8,5,boot);px(9,5,boot);px(10,5,boot);px(11,5,boot); }
    // 腿
    px(4,8,c);px(5,8,leg);px(6,8,leg);px(7,8,c);
    px(4,9,c);px(5,9,leg);px(6,9,leg);px(7,9,c);
    px(4,10,c);px(5,10,legD);px(6,10,legD);px(7,10,c);
    // 靴
    px(4,11,c);px(5,11,boot);px(6,11,boot);px(7,11,c);
  });
}
function makeZombie(color,shade,colorD,armor){
  return makeSprite(12,14,(g,px)=>{
    const c="#1a1a1a";
    const skin="#9ab88a", skinD="#6a8a5a";
    const rag="#5a5a5a", ragD="#3a3a3a";
    // 头(下垂/龇牙)
    px(4,0,c);px(5,0,c);px(6,0,c);px(7,0,c);
    px(3,1,c);px(4,1,skin);px(5,1,skin);px(6,1,skin);px(7,1,skin);px(8,1,c);
    px(3,2,c);px(4,2,skin);px(5,2,skinD);px(6,2,skinD);px(7,2,skin);px(8,2,c);
    px(3,3,c);px(4,3,skinD);px(5,3,skinD);px(6,3,skin);px(7,3,skinD);px(8,3,c);
    px(4,4,c);px(5,4,skinD);px(6,4,skinD);px(7,4,c);
    // 躯干(破烂衣物)
    px(3,5,c);px(4,5,color);px(5,5,color);px(6,5,color);px(7,5,color);px(8,5,c);
    px(3,6,c);px(4,6,shade);px(5,6,color);px(6,6,color);px(7,6,shade);px(8,6,c);
    px(3,7,c);px(4,7,color);px(5,7,colorD);px(6,7,color);px(7,7,colorD);px(8,7,c);
    // 张开的嘴/血
    px(5,4,"#8f3a3a");px(6,4,"#8f3a3a");
    // 腿(不对称, 蹒跚)
    px(4,8,c);px(5,8,rag);px(6,8,c);px(7,8,c);px(8,8,ragD);
    px(4,9,c);px(5,9,ragD);px(7,9,rag);px(8,9,c);
    px(5,10,c);px(5,10,rag);px(8,10,ragD);
    if(armor){ // 装甲碎片
      px(3,4,"#4a4a5a");px(8,4,"#4a4a5a");px(3,8,"#4a4a5a");px(8,8,"#4a4a5a");
    }
  });
}
function makeCivilian(){
  return makeSprite(10,14,(g,px)=>{
    const c="#1a1a1a";
    const skin="#e8c89a", skinD="#c8a878";
    const coat="#c0a070", coatD="#907050";
    const hair="#5a4a3a";
    px(3,0,c);px(4,0,hair);px(5,0,hair);px(6,0,hair);px(7,0,c);
    px(2,1,c);px(3,1,skin);px(4,1,skin);px(5,1,skin);px(6,1,skin);px(7,1,skin);px(8,1,c);
    px(2,2,c);px(3,2,skin);px(4,2,skinD);px(5,2,skinD);px(6,2,skin);px(7,2,skin);px(8,2,c);
    px(2,3,c);px(3,3,coat);px(4,3,coat);px(5,3,coat);px(6,3,coat);px(7,3,coat);px(8,3,c);
    px(2,4,c);px(3,4,coat);px(4,4,coatD);px(5,4,coat);px(6,4,coatD);px(7,4,coat);px(8,4,c);
    px(2,5,c);px(3,5,coat);px(4,5,coat);px(5,5,coat);px(6,5,coat);px(7,5,coat);px(8,5,c);
    px(3,6,c);px(4,6,coatD);px(5,6,coat);px(6,6,coatD);px(7,6,c);
    px(4,7,c);px(5,7,coat);px(6,7,coat);px(7,7,c);
    px(4,8,c);px(5,8,coat);px(6,8,coat);px(7,8,c);
  });
}
// 像素建筑(16x14 基准)
function makeBuilding(kind,lvl){
  return makeSprite(16,14,(g,px)=>{
    const c="#1a1a1a";
    const roof="#8a5a3a", roofD="#6a4a2a", wall="#c8a060", wallD="#a07840";
    const door="#6a4a2a", win="#60a0c8";
    const stone="#9a9a8a", stoneD="#7a7a6a";
    const base = lvl>0 ? wall : stoneD;
    // 屋顶
    for(let i=0;i<3;i++){
      const off=1+i;
      for(let x=off;x<16-off;x++){ px(x,0,c); }
    }
    for(let x=2;x<15;x++){ px(x,1,roof); px(x,2,roofD); }
    px(8,0,roof); px(7,0,roof);
    // 墙
    for(let y=3;y<13;y++)for(let x=1;x<16;x++){
      if(x===0||x===16||y===13) continue;
      let col = (kind==="wall") ? stone : base;
      // 砖缝纹理(横向)
      if(y%4===0 && x>1 && x<15) col = (kind==="wall")?stoneD:(kind==="wall"?"#8a8a7a":"#9a7840");
      px(x,y,col);
    }
    // 门
    for(let y=7;y<13;y++){ px(6,y,door); px(7,y,door); }
    px(6,6,door);px(7,6,door);
    // 窗(左侧)
    if(kind!=="wall"){
      px(3,5,win);px(4,5,win);px(3,6,win);px(4,6,win);
      px(3,5,c);px(4,5,c); // 窗框简化
    }
    // 屋顶烟囱
    if(kind==="kitchen"){ px(11,0,stoneD);px(12,0,stoneD);px(11,1,stone);px(12,1,stone); }
    if(kind==="radio"){ px(11,0,c);px(12,0,stone);px(11,1,stone);px(12,1,stone);px(11,2,stone); }
    // 等级徽章
    if(lvl>0){
      for(let i=0;i<Math.min(lvl,3);i++){ px(11+i*2,12,win); }
    }
  });
}
// 地皮像素纹理(战斗 深绿地 + 营地 暖土色)
let groundTex=null, groundTexCamp=null;
function makeGround(col1,col2,col3){
  return makeSprite(64,64,(g,px)=>{
    for(let y=0;y<64;y++)for(let x=0;x<64;x++){
      const n=(x*7+y*13+(x*y)%5)%7;
      let col=col1;
      if(n===0)col=col2; else if(n===2)col=col3; else if(n===5)col=col2;
      px(x,y,col);
    }
    // 随机碎石/草点
    for(let i=0;i<40;i++){ const x=(i*37)%64,y=(i*53)%64; px(x,y,col3); }
  });
}
// 预生成 sprite(模块加载时)
const SPR={};
function buildSprites(){
  SPR.soldier=[ makeSoldier("#5a8a4a","#7aaa5a","gun"),
                makeSoldier("#4a7aa0","#6a9ac0","gun"),
                makeSoldier("#c08a3a","#e0a84a","snipe") ];
  SPR.zombie={ walker:makeZombie("#7a9a6a","#9aba8a","#5a7a4a",false),
               fatty:makeZombie("#8a6a4a","#aa8a5a","#6a4a3a",false),
               king:makeZombie("#8a4a5a","#aa6a7a","#6a2a3a",true) };
  SPR.civ=makeCivilian();
  SPR.bld={};
  ["barracks","workshop","kitchen","medbay","wall","radio"].forEach(k=>{
    SPR.bld[k]={0:makeBuilding(k,0),1:makeBuilding(k,1),2:makeBuilding(k,2),3:makeBuilding(k,3)};
  });
  groundTex=makeGround("#3a5a3a","#2f4a2f","#4a6a4a");
  groundTexCamp=makeGround("#5a4a3a","#4a3a2a","#6a5a4a");
}
buildSprites();
function drawSprite(g,sp,x,y,w,h,flash){
  g.drawImage(sp, x, y, w, h);
  if(flash>0){ g.globalAlpha=Math.min(1,flash*4); g.fillStyle="#fff"; g.fillRect(x,y,w,h); g.globalAlpha=1; }
}

// 自动推进兵线: 士兵沿敌方来袭方向(x+)推进到射程内
function advancePos(s,d){
  // 朝右侧(敌人来袭方向)推进 射程的 0.9 倍
  const tx=Math.min(VIEW_W-CELL*1.2, s.x + d.range*0.9);
  return {x:tx, y:s.y};
}
/* ==================== 状态 ==================== */
let S=null, view="camp", paused=false, inBattle=false, spawnQueue=[], battleT=0, spawnTimer=0, civ=null, lastSave=0, offT=0;
let tapMarker=null;      // {x,y,life} 点击涟漪反馈
let camX=0, camY=0;      // 摄像机(跟随视角), 世界坐标
let bldRects=[];         // 营地建筑槽位(世界坐标), 供画布点击
function newState(){
  return {
    gold:160,part:2,food:14,med:0,
    bld:{barracks:1,workshop:0,kitchen:0,medbay:0,wall:0,radio:0},
    crew:[{type:0,hp:130,mor:100,wep:"m9"},{type:1,hp:90,mor:100,wep:"m9"},{type:2,hp:70,mor:100,wep:"m9"}],
    crewMax:3,
    mission:1, won:0,
    weapon:"m9",
    day:1,
    offlineMax:8*3600*1000
  };
}
/* ==================== 存档 ==================== */
const LS_KEY="ares_squad_v1";
function save(){
  if(paused) paused=false;
  try{ localStorage.setItem(LS_KEY,JSON.stringify({S,offT:0,ts:Date.now()})); toast("已存档"); }catch(e){}
  lastSave=Date.now(); offT=0;
}
function load(){
  let d=null;
  try{ d=JSON.parse(localStorage.getItem(LS_KEY)||"null"); }catch(e){}
  if(d && d.S){ S=d.S; offT=d.offT||0; lastSave=d.ts||Date.now(); }
}
function resetAll(){ localStorage.removeItem(LS_KEY); location.reload(); }
/* 测试钩子: 重置为新存档(不清 localStorage) */
function __resetSave(){ S=newState(); lastSave=Date.now(); offT=0; view="camp"; inBattle=false; }
/* ==================== 离线收益 ==================== */
function offlineGain(){
  let ms=Date.now()-lastSave; if(ms<60000) return;
  ms=Math.min(ms,S.offlineMax);
  let foodCap=bldLv("kitchen")*15+10, partRate=bldLv("workshop");
  const g=Math.floor(ms/3600*1000);
  S.food=Math.min(foodCap,S.food+g*0.6|0);
  S.part+=partRate*g*0.4;
  S.gold+=12*partRate+g*0.3;
  return g;
}
function bldLv(id){ return S.bld[id]||0; }
/* ==================== 提示 ==================== */
let toastT=null;
function toast(msg){ const t=document.getElementById("toast"); t.textContent=msg; t.style.display="block"; t.style.animation="none"; void t.offsetWidth; t.style.animation=""; clearTimeout(toastT); toastT=setTimeout(()=>t.style.display="none",2400); }
/* ==================== 营地渲染 (DOM) ==================== */
function refreshHud(){
  document.getElementById("hGold").textContent=Math.floor(S.gold);
  document.getElementById("hPart").textContent=Math.floor(S.part);
  document.getElementById("hFood").textContent=Math.floor(S.food);
  document.getElementById("hMed").textContent=S.med;
}
function bldLayout(){
  const bpos={barracks:[4,3],workshop:[8,3],kitchen:[12,3],medbay:[16,3],wall:[19,3],radio:[22,3]};
  const out=[];
  BUILDINGS.forEach(b=>{
    const p=bpos[b.id];
    out.push({id:b.id,x:p[0]*CELL,y:VIEW_H-CELL*2,w:CELL*1.6,h:CELL*1.6});
  });
  return out;
}
function renderCamp(){
  view="camp";
  bldRects=bldLayout();
  document.getElementById("viewTag").textContent="营地 · 前哨";
  document.getElementById("campPanel").style.display="flex";
  document.getElementById("battleBar").style.display="none";
  document.getElementById("missionBanner").style.display="none";
  const grid=document.getElementById("bldGrid"); grid.innerHTML="";
  BUILDINGS.forEach(b=>{
    const lv=S.bld[b.id]||0;
    const el=document.createElement("div");
    el.className="bld"+(lv>0?" built":" empty");
    const next=b.cost[lv];
    // 像素风: 建筑卡片配 32x30 像素图
    el.innerHTML=(lv>0?'<span class="lv">Lv'+lv+'</span>':'')+'<canvas class="bldSprite" width="32" height="30"></canvas><div class="nm">'+b.nm+'</div>'+
      (next!=null?'<div class="cost">'+(lv===0?"建": "升")+' 💰'+next+'</div><div style="color:#7f95c9">'+b.desc+'</div>':'<div class="cost" style="color:#7f95c9">已满级</div>');
    el.onclick=()=>{
      if(next==null){ toast("已满级"); return; }
      if(S.gold<next){ toast("金币不足,需💰"+next); return; }
      S.gold-=next; S.bld[b.id]=lv+1;
      if(b.id==="barracks"){ S.crewMax=lv+2; addCrew(lv); }
      refreshHud(); renderCamp(); toast(b.nm+(lv===0?"已建成":"升至Lv"+(lv+1)));
    };
    grid.appendChild(el);
    const cs=el.querySelector("canvas.bldSprite");
    if(cs&&SPR.bld[b.id]){
      const g=cs.getContext("2d"); g.imageSmoothingEnabled=false;
      g.clearRect(0,0,32,30);
      g.drawImage(SPR.bld[b.id][Math.min(lv,3)],0,0,16,14,0,0,32,30);
    }
  });
  // 小队
  const row=document.getElementById("crewRow"); row.innerHTML="";
  S.crew.forEach((c,i)=>{
    const d=CREO_DEF[c.type];
    const el=document.createElement("div"); el.className="crew";
    const hpPct=Math.max(0,Math.min(100,c.hp/d.hp*100));
    const morPct=Math.max(0,Math.min(100,c.mor));
    // 像素风: 小队面板用 24x30 像素 sprite 替代 emoji
    el.innerHTML='<div class="nm"><canvas class="cSprite" width="24" height="30"></canvas> '+d.nm+' <span style="color:#7f95c9">Lv'+(S.won+1)+'</span></div>'+
      '<div class="bar"><i style="width:'+hpPct+'%"></i></div>'+
      '<div class="bar mor"><i style="width:'+morPct+'%"></i></div>'+
      '<div class="st">'+((WEAPONS.find(w=>w.id===c.wep)||{}).nm||"M9步枪")+'</div>';
    row.appendChild(el);
    // 把像素 sprite 画入小队面板的 canvas(关闭平滑放大)
    const cs=el.querySelector("canvas.cSprite");
    if(cs&&SPR.soldier[c.type]){
      const g=cs.getContext("2d"); g.imageSmoothingEnabled=false;
      g.clearRect(0,0,24,30);
      g.drawImage(SPR.soldier[c.type],0,0,12,16,0,0,24,30);
    }
  });
  document.getElementById("wName").textContent=(WEAPONS.find(w=>w.id===S.weapon)||{}).nm||"";
  // 制作
  const mk=document.getElementById("makeRow"); mk.innerHTML="";
  MAKES.forEach(mk0=>{
    const el=document.createElement("div"); el.className="make";
    const ok = S.part>=mk0.part && S.gold>=mk0.gold && bldLv(mk0.need)>0;
    el.innerHTML='<div class="nm">'+mk0.nm+'</div><div class="cost">🔩'+mk0.part+' 💰'+mk0.gold+(bldLv(mk0.need)===0?" · 需"+BUILDINGS.find(b=>b.id===mk0.need).nm:"")+'</div><div style="color:#7f95c9">'+mk0.desc+'</div>';
    el.onclick=()=>{
      if(bldLv(mk0.need)===0){ toast("需先建造"+BUILDINGS.find(b=>b.id===mk0.need).nm); return; }
      if(S.part<mk0.part){ toast("零件不足"); return; }
      if(S.gold<mk0.gold){ toast("金币不足"); return; }
      S.part-=mk0.part; S.gold-=mk0.gold;
      if(mk0.id==="med"){ S.med+=1; toast("医疗包+1"); }
      else if(mk0.id==="boost"){ S.crew.forEach(c=>c.mor=Math.min(120,c.mor+15)); toast("步枪强化:士气+15"); }
      else { S.weapon="snipe"; toast("狙击弹已装备"); }
      refreshHud(); renderCamp();
    };
    mk.appendChild(el);
  });
  // 事件
  const ev=document.getElementById("evLine");
  if(S.food<3){ ev.className="ev-line bad"; ev.textContent="⚠ 食物告急!士气将持续下降,建厨房或完成任务补粮"; }
  else if(S.won===2 && S.mission===3){ ev.className="ev-line mix"; ev.textContent="📡 电台:检测到僵尸王活动,尸潮夜袭任务已开放"; }
  else if(S.crew.some(c=>c.hp<CREO_DEF[c.type].hp*0.4)){ ev.className="ev-line bad"; ev.textContent="🏥 有士兵带伤,建议医疗站治疗后再出击"; }
  else { ev.className="ev-line"; ev.textContent="✅ 营地运转正常,可以出击了"; }
  // 提示
  document.getElementById("campHint").textContent=hintLine();
  document.getElementById("mName").textContent=missionName();
  document.getElementById("btnDeploy").disabled = S.mission>3;
  // 背景画静态营地
  drawCampStatic();
}
function missionLabel(){ if(S.mission>3) return "4+"; return S.mission; }
function missionName(){ if(S.mission>3) return "已通关"; return MISSIONS[S.mission-1].nm; }
function hintLine(){
  if(S.food<3) return "优先建厨房/完成任务补食物";
  if(bldLv("workshop")===0) return "建议先建工坊,解锁制作系统";
  if(S.part>=3 && S.gold>=40 && bldLv("workshop")>0) return "可以制作狙击弹了";
  if(S.crew.length<3 && bldLv("barracks")<3) return "升级兵营扩充小队";
  return "出击获取资源,回营地升级建筑";
}
function addCrew(idx){
  const t=[0,1,2][Math.min(idx,2)]||0;
  if(S.crew.length>=4) return;
  S.crew.push({type:t,hp:CREO_DEF[t].hp,mor:100,wep:"m9"});
}
/* 点击士兵治疗 (医疗站) */
document.addEventListener("DOMContentLoaded",()=>{ const bh=document.getElementById("btnHeal"); if(bh) bh.onclick=healCrew; });
function healCrew(){
  if(bldLv("medbay")===0){ toast("需先建医疗站"); return; }
  if(S.med<=0){ toast("医疗包不足,去工坊制作"); return; }
  S.med--;
  S.crew.forEach(c=>{ c.hp=CREO_DEF[c.type].hp; c.mor=Math.min(110,c.mor+20); });
  toast("全小队治愈");
  refreshHud(); renderCamp();
}
/* ==================== 出击/战斗 ==================== */
function deploy(){
  if(inBattle) return;
  if(S.mission>3){ toast("已通关全部原型任务!"); return; }
  if(paused){ paused=false; document.getElementById("btnPause").textContent="⏸"; }
  if(S.food<1){ toast("没粮出不了击,先补食物"); return; }
  inBattle=true; view="battle";
  document.getElementById("campPanel").style.display="none";
  document.getElementById("battleBar").style.display="flex";
  const m=MISSIONS[S.mission-1];
  const mb=document.getElementById("missionBanner");
  mb.style.display="block"; mb.textContent="任务"+S.mission+" · "+m.nm+" — "+m.desc;
  startBattle(m);
}
let soldiers=[], enemies=[];
function startBattle(m){
  battleT=0; paused=false; spawnQueue=[]; spawnTimer=0;
  civ=null;
  camX=0; camY=0;   // 摄像机归位(跟随出生区)
  soldiers=S.crew.map((c,i)=>({
    x:2*CELL, y:(4+i*2)*CELL, type:c.type, hp:CREO_DEF[c.type].hp,
    mor:c.mor, wep:c.wep, rate:0, cd:0, moving:false, tx:null, ty:null, cmdHold:0, alive:true, flash:0
  }));
  enemies=[];
  m.enemies.forEach(g=>{ for(let i=0;i<g.n;i++){
    spawnQueue.push({t:g.t,x:(g.r[0]+Math.random()*(g.r[1]-g.r[0]))*CELL,y:(2+Math.random()*(ROWS-4))*CELL});
  }});
  if(m.type==="escort"){ civ={x:2*CELL,y:8*CELL,hp:60}; }
  // 士气 buff
  soldiers.forEach(s=>{ if(s.mor>90) s.atkBoost=1.15; else s.atkBoost=0.85; });
}
/* ---- 输入 ---- */
const cv=document.getElementById("cv");
function cvPos(e){
  const r=cv.getBoundingClientRect();
  if(r.width<2||r.height<2) return null;
  const t=e.touches?e.touches[0]:(e.changedTouches?e.changedTouches[0]:e);
  if(!t) return null;
  // 视口坐标 → 世界坐标(战斗视角加摄像机偏移; 营地视角 cam=0)
  const sx=(t.clientX-r.left)*(VIEW_W/r.width), sy=(t.clientY-r.top)*(VIEW_H/r.height);
  const cx=(view==="battle")?camX:0, cy=(view==="battle")?camY:0;
  return {x:sx+cx, y:sy+cy};
}
function onCampTap(p){
  // 点建筑槽位 → 建造 / 升级
  for(const r of bldRects){
    if(p.x>=r.x&&p.x<=r.x+r.w&&p.y>=r.y&&p.y<=r.y+r.h){
      const b=BUILDINGS.find(x=>x.id===r.id);
      const lv=S.bld[b.id];
      const cost=b.cost[lv];
      if(cost==null){ toast(b.nm+" 已满级"); return; }
      if(S.gold<cost){ toast("金币不足,需💰"+cost); return; }
      S.gold-=cost; S.bld[b.id]=lv+1;
      if(b.id==="barracks"){ S.crewMax=lv+2; addCrew(lv); }
      refreshHud(); renderCamp();
      toast(b.nm+(lv===0?"已建成":"升至Lv"+(lv+1)));
      return;
    }
  }
}
function onBattleTap(e){
  if(e.cancelable) e.preventDefault();
  if(!inBattle) return;
  if(paused){ paused=false; const bp=document.getElementById("btnPause"); if(bp) bp.textContent="⏸"; }
  const p=cvPos(e);
  if(!p) return;
  tapMarker={x:p.x,y:p.y,life:0.5};
  // 点敌人 → 全队集火(扩大判定半径; 下达"集火指令"覆盖自动推进)
  let hit=null,best=1e9;
  enemies.forEach(en=>{ if(!en.alive)return; const dd=Math.hypot(en.x-p.x,en.y-p.y); if(dd<40&&dd<best){best=dd;hit=en;} });
  if(hit){
    soldiers.forEach((s,i)=>{
      if(!s.alive) return;
      s.target=hit;
      // 集火时: 每个士兵按自身射程在目标周围占位(保持梯队, 避免重叠), 钳制在镜头可视区内
      const d=CREO_DEF[s.type];
      const ring=Math.min(d.range*0.8, 120), ang=(i-Math.floor(soldiers.length/2))*0.7;
      let nx=hit.x-Math.cos(ang)*ring, ny=hit.y-Math.sin(ang)*ring*0.5;
      nx=Math.max(camX,Math.min(camX+VIEW_W,nx));
      ny=Math.max(camY,Math.min(camY+VIEW_H,ny));
      s.tx=nx; s.ty=ny; s.cmdHold=6;   // 玩家集火指令: 6s 内不被自动推进覆盖
    });
    return;
  }
  // 点空地 → 全队移动(三个角色一起行动; 按自身队列位置排开, 钳制在镜头可视区内)
  {
    const mx=Math.max(camX,Math.min(camX+VIEW_W,p.x));
    const my=Math.max(camY,Math.min(camY+VIEW_H,p.y));
    soldiers.forEach((s,i)=>{
      if(!s.alive) return;
      // 按兵种梯队排开: 步前 / 机中 / 狙后, 避免挤成一团
      const off=[{dx:20,dy:0},{dx:0,dy:-36},{dx:0,dy:36}][i]||{dx:0,dy:0};
      let nx=Math.max(camX,Math.min(camX+VIEW_W,mx+off.dx));
      let ny=Math.max(camY,Math.min(camY+VIEW_H,my+off.dy));
      s.tx=nx; s.ty=ny; s.target=null; s.cmdHold=6;   // 玩家移动指令: 6s 内不被自动推进覆盖
    });
  }
}
function onCampCanvasTap(e){
  if(!inBattle){
    const p=cvPos(e);
    if(p){ tapMarker={x:p.x,y:p.y,life:0.5}; onCampTap(p); }
  }
}
function handleCanvasTap(e){
  if(view==="battle"||inBattle) onBattleTap(e);
  else onCampCanvasTap(e);
}
cv.addEventListener("touchstart",handleCanvasTap,{passive:false});
cv.addEventListener("touchend",handleCanvasTap,{passive:false});
cv.addEventListener("touchmove",e=>{ if(e.target===cv) e.preventDefault(); },{passive:false});
cv.addEventListener("mousedown",handleCanvasTap);
function useSkill(kind){
  if(paused||!inBattle) return;
  if(kind==="grenade"){
    if(S.part<1){ toast("需1个零件装填手雷"); return; }
    S.part--; refreshHud();
    // 对可见区(摄像机视野)内最近敌方集群
    const cx0=camX+VIEW_W*0.5, cy0=camY+VIEW_H*0.5;
    let sx=0,sy=0,n=0;
    enemies.forEach(en=>{ if(en.alive&&Math.hypot(en.x-cx0,en.y-cy0)<VIEW_W*0.7){sx+=en.x;sy+=en.y;n++;} });
    if(n===0) return;
    boom(sx/n,sy/n,70,60);
    toast("🧨 手雷引爆!");
  } else if(kind==="racket"){
    if(S.gold<20){ toast("需20金币装填火箭"); return; }
    S.gold-=20; refreshHud();
    const cx0=camX+VIEW_W*0.5, cy0=camY+VIEW_H*0.5;
    let sx=0,sy=0,n=0;
    enemies.forEach(en=>{ if(en.alive&&Math.hypot(en.x-cx0,en.y-cy0)<VIEW_W*0.7){sx+=en.x;sy+=en.y;n++;} });
    if(n===0) return;
    boom(sx/n,sy/n,90,120);
    toast("🚀 火箭齐射!");
  }
}
function boom(x,y,r,dmg){
  enemies.forEach(en=>{ if(!en.alive)return; if(Math.hypot(en.x-x,en.y-y)<r){ en.hp-=dmg; en.flash=0.2; } });
  for(let i=0;i<14;i++){
    const a=Math.random()*Math.PI*2, sp=30+Math.random()*90;
    fx.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:0.5,color:"#ffd75a"});
  }
}
let fx=[];
/* ---- 战斗逻辑 ---- */
function updateBattle(dt){
  battleT+=dt;
  // 摄像机跟随小队质心(或平民): 小队保持在视野中部偏左, 右侧留给推进/来敌
  {
    let sx=0,sy=0,n=0;
    soldiers.forEach(s=>{ if(s.alive){sx+=s.x;sy+=s.y;n++;} });
    if(civ&&civ.hp>0){ sx+=civ.x; sy+=civ.y; n++; }
    if(n>0){ sx/=n; sy/=n; } else { sx=VIEW_W*0.3; sy=VIEW_H*0.5; }
    // 关键: 摄像机不能"抛下"士兵——左缘必须 ≤ 最左存活士兵(留 0.25 视口边距), 右缘必须 ≥ 最右存活士兵
    let minX=1e9,maxX=-1e9,minY=1e9,maxY=-1e9;
    soldiers.forEach(s=>{ if(!s.alive)return; minX=Math.min(minX,s.x);maxX=Math.max(maxX,s.x);minY=Math.min(minY,s.y);maxY=Math.max(maxY,s.y); });
    if(civ&&civ.hp>0){ minX=Math.min(minX,civ.x);maxX=Math.max(maxX,civ.x);minY=Math.min(minY,civ.y);maxY=Math.max(maxY,civ.y); }
    const padX=VIEW_W*0.25, padY=VIEW_H*0.25;
    let lo=Math.max(0, minX-padX);
    let hi=Math.min(WORLD_W-VIEW_W, maxX-padX);
    let loY=Math.max(0, minY-padY);
    let hiY=Math.min(WORLD_H-VIEW_H, maxY-padY);
    const tgt=hi>=lo ? Math.max(lo,Math.min(hi,sx-VIEW_W*0.45)) : Math.max(0,Math.min(WORLD_W-VIEW_W,(lo+hi)/2));
    const tgtY=hiY>=loY ? Math.max(loY,Math.min(hiY,sy-VIEW_H*0.5)) : Math.max(0,Math.min(WORLD_H-VIEW_H,(loY+hiY)/2));
    const k=Math.min(1,dt*4);   // 平滑跟随
    camX+=(tgt-camX)*k; camY+=(tgtY-camY)*k;
    // 最终兜底: 摄像机永远不越出"小队所在区"(保证小队始终在屏内)
    camX=Math.max(0,Math.min(WORLD_W-VIEW_W,camX));
    camY=Math.max(0,Math.min(WORLD_H-VIEW_H,camY));
  }
  // 生成
  spawnTimer-=dt;
  if(spawnQueue.length>0&&spawnTimer<=0){
    spawnTimer=1.6;
    const q=spawnQueue.shift();
    const d=ENEMY_DEF[q.t];
    // 敌人从镜头可视区右缘内侧生成(始终可见), 配合士兵出屏约束形成持续推进
    const ex=Math.min(WORLD_W-CELL, camX+VIEW_W-CELL);
    enemies.push({t:q.t,x:ex,y:q.y,hp:d.hp,maxHp:d.hp,atk:d.atk,speed:d.speed,range:d.range,armor:d.armor||0,alive:true,cd:0,flash:0});
  }
  // 士兵
  soldiers.forEach(s=>{
    if(!s.alive) return;
    s.cd=Math.max(0,s.cd-dt);   // 射速冷却递减
    const d=CREO_DEF[s.type];
    // 移动(玩家指令优先; 无指令时自动推进)
    if(s.tx!=null&&s.ty!=null){
      const dx=s.tx-s.x, dy=s.ty-s.y, dist=Math.hypot(dx,dy);
      if(dist>6){ s.x+=dx/dist*Math.min(120*dt,dist); s.y+=dy/dist*Math.min(120*dt,dist); }
      else { s.tx=s.ty=null; }
      if(s.cmdHold>0) s.cmdHold-=dt;          // 玩家指令倒计时
    }
    // 硬约束: 士兵始终保持在镜头可视区内(不出屏); 目标越界时丢弃
    {
      const m=CELL*0.5;
      if(s.x<camX+m||s.x>camX+VIEW_W-m||s.y<camY+m||s.y>camY+VIEW_H-m){
        s.x=Math.max(camX+m,Math.min(camX+VIEW_W-m,s.x));
        s.y=Math.max(camY+m,Math.min(camY+VIEW_H-m,s.y));
        s.tx=null; s.ty=null;
      }
    }
    // 自动推进: 仅当"无玩家指令且不在指令保持窗口"时, 朝最近敌人推进到射程内(每帧执行)
    // 约束: 士兵始终保持在镜头可视区内(不出屏), 因此只追"视野内"的敌人
    if(s.tx==null&&s.ty==null&&s.cmdHold<=0){
      let bt=null,bd=1e9;
      const inView=(x,y,pad)=>{ pad=pad||0; return x>=camX-pad&&x<=camX+VIEW_W+pad&&y>=camY-pad&&y<=camY+VIEW_H+pad; };
      for(const en of enemies){ if(!en.alive||!inView(en.x,en.y)) continue;
        const dd=Math.hypot(en.x-s.x,en.y-s.y);
        if(dd<bd){bd=dd;bt=en;}
      }
      if(bt){
        s.target=bt;
        if(bd>d.range*0.95){
          const dirx=(bt.x-s.x)/(bd||1), diry=(bt.y-s.y)/(bd||1);
          let nx=s.x+dirx*d.range*0.9, ny=s.y+diry*d.range*0.9;
          nx=Math.max(camX,Math.min(camX+VIEW_W,nx));
          ny=Math.max(camY,Math.min(camY+VIEW_H,ny));
          s.tx=nx; s.ty=ny;
        } else { s.tx=null; s.ty=null; } // 已在射程内→原地输出
      } else s.target=null;
    }
    // 攻击
    if(s.cd<=0){
      let tgt=s.target;
      if(tgt&&tgt.alive){
        const distT=Math.hypot(tgt.x-s.x,tgt.y-s.y);
        if(distT<=d.range){
          const wd=WEAPONS.find(w=>w.id===s.wep)||WEAPONS[0];
          let dmg=d.atk*(s.atkBoost||1)*(wd.atk||1);
          if(s.type===2 && tgt.armor) dmg+=8; // 狙击破甲
          tgt.hp-=dmg;
          if(tgt.hp<1){ tgt.hp=0; } // 消除浮点残血
          tgt.flash=0.15;
          s.cd=d.rate/100;
          // 弹道特效
          fx.push({x:s.x,y:s.y,tx:tgt.x,ty:tgt.y,line:true,life:0.12,color:s.type===2?"#ffd75a":"#8ce6a0"});
        }
      }
    }
  });
  // 敌人
  enemies.forEach(en=>{
    if(!en.alive) return;
    en.flash=Math.max(0,en.flash-dt);
    en.cd-=dt;
    // 目标: 士兵或平民
    let txs=null,ty=1e9;
    let target=null;
    if(civ){ const dc=Math.hypot(civ.x-en.x,civ.y-en.y); if(dc<ty){ty=dc;target=civ;} }
    soldiers.forEach(s=>{ if(s.alive){ const d2=Math.hypot(s.x-en.x,s.y-en.y); if(d2<ty){ty=d2;target=s;} }});
    if(target){
      const dx=target.x-en.x, dy=target.y-en.y, dist=Math.hypot(dx,dy)||1;
      if(dist>en.range){ en.x+=dx/dist*en.speed*dt; en.y+=dy/dist*en.speed*dt; }
      else if(en.cd<=0){
        en.cd=1;
        if(target===civ){ civ.hp-=en.atk; if(civ.hp<1)civ.hp=0; }
        else { target.hp-=Math.max(1,en.atk); if(target.hp<1)target.hp=0; target.flash=0.15; }
      }
    }
    if(en.hp<1){
      en.alive=false;
      S.gold+= (en.t==="king"?80:10);
      S.part+= (en.t==="king"?2: (Math.random()<0.4?1:0));
      fx.push({x:en.x,y:en.y,life:0.4,color:"#ff6f6f"});
    }
  });
  // 士兵阵亡判定
  soldiers.forEach(s=>{ if(s.alive&&s.hp<1){ s.alive=false; s.target=null; s.tx=null; s.ty=null; fx.push({x:s.x,y:s.y,life:0.5,color:"#556"}); } });
  fx.forEach(f=>f.life-=dt); fx=fx.filter(f=>f.life>0);
  refreshHud();
  // 胜负
  const alive=soldiers.some(s=>s.alive);
  const m=MISSIONS[S.mission-1];
  if(m.type==="escort"){
    if(civ){ civ.x+=30*dt; if(civ.x>=WORLD_W-CELL){ endBattle(true,"平民成功穿越!"); return; } }
    if(civ&&civ.hp<=0){ endBattle(false,"平民被劫杀!"); return; }
  } else {
    if(!alive){ endBattle(false,"小队全灭!"); return; }
    if(spawnQueue.length===0 && enemies.every(e=>!e.alive) && alive){ endBattle(true,"区域已清剿!"); return; }
  }
}
function endBattle(win,msg){
  inBattle=false; view="camp";
  document.getElementById("battleBar").style.display="none";
  document.getElementById("missionBanner").style.display="none";
  document.getElementById("campPanel").style.display="flex";
  const m=MISSIONS[S.mission-1];
  const box=document.getElementById("resultBox");
  if(win){
    S.mission++; S.won++;
    const r=m.reward;
    S.gold+=r.gold; S.part+=r.part; S.food+=r.food; S.med+=r.med;
    S.food=Math.max(0,S.food-1); // 出击耗粮
    // 士气恢复
    S.crew.forEach((c,i)=>{ const s=soldiers[i]; if(s){ c.hp=Math.max(1,Math.min(CREO_DEF[c.type].hp,s.hp)); c.mor=Math.max(20,c.mor*(win?1:0.7)); } });
    box.innerHTML="<h2>✅ 任务"+m.id+" 完成 · "+msg+"</h2>"+
      "奖励: 💰"+r.gold+" 🔩"+r.part+" 🍖"+r.food+" 💊"+r.med+"<br>"+
      (S.mission<=3 ? "下一任务: "+MISSIONS[S.mission-1].nm+" 已解锁" : "🏆 全部原型任务通关!<br>解锁章节2:研究所之谜(正式版)");
  } else {
    S.food=Math.max(0,S.food-2);
    box.innerHTML="<h2 class='lose'>❌ 任务失败 · "+msg+"</h2>补给消耗💰-2金币未损失,回营地休整后再来<br>"+
      "提示: 用🧨/🚀控制战场节奏,医疗站治疗士兵";
  }
  document.getElementById("resultOverlay").style.display="flex";
  setTimeout(()=>{ document.getElementById("resultOverlay").style.display="none"; refreshHud(); renderCamp(); },1800);
  // 战后士兵恢复
  S.crew.forEach((c,i)=>{ const s=soldiers[i]; if(s){ c.hp=Math.max(1,Math.min(CREO_DEF[c.type].hp,s.hp)); c.mor=Math.max(20,c.mor*(win?1:0.7)); } });
}
/* ==================== 画布渲染 ==================== */
let last=0;
function loop(t){
  const dt=Math.min(0.05,(t-last)/1000||0); last=t;
  if(inBattle&&!paused){ updateBattle(dt); }
  render(dt);
  requestAnimationFrame(loop);
}
function render(dt){
  const ctx=cv.getContext("2d");
  ctx.clearRect(0,0,VIEW_W,VIEW_H);
  const isBattle=(view==="battle"&&inBattle);
  // 摄像机: 战斗视角平移世界, 营地视角居中
  const ox=isBattle?camX:0, oy=isBattle?camY:0;
  // 像素风关键: 关闭平滑, 放大 sprite 时保持锐利
  ctx.imageSmoothingEnabled=false;
  // 背景像素地皮(战斗深绿地 / 营地暖土色), 世界坐标平铺
  {
    const gtex=(isBattle)?groundTex:groundTexCamp;
    const wx0=Math.max(0,Math.floor(ox/64)*64), wy0=Math.max(0,Math.floor(oy/64)*64);
    if(gtex){
      for(let wy=wy0;wy<oy+VIEW_H;wy+=64){
        for(let wx=wx0;wx<ox+VIEW_W;wx+=64){
          ctx.drawImage(gtex, wx, wy, 64, 64);
        }
      }
    } else { ctx.fillStyle="#0a1410"; ctx.fillRect(0,0,VIEW_W,VIEW_H); }
  }
  ctx.save();
  ctx.translate(-ox,-oy);
  ctx.strokeStyle="rgba(47,79,58,.35)"; ctx.lineWidth=1;
  if(isBattle){
    // 战场网格按世界坐标绘制(仅绘制可见区, 提升性能)
    const x0=Math.max(0,Math.floor(ox/CELL)*CELL), x1=Math.min(WORLD_W,ox+VIEW_W);
    const y0=Math.max(0,Math.floor(oy/CELL)*CELL), y1=Math.min(WORLD_H,oy+VIEW_H);
    for(let x=x0;x<=x1;x+=CELL){ ctx.beginPath(); ctx.moveTo(x,oy); ctx.lineTo(x,y1); ctx.stroke(); }
    for(let y=y0;y<=y1;y+=CELL){ ctx.beginPath(); ctx.moveTo(ox,y); ctx.lineTo(ox+VIEW_W,y); ctx.stroke(); }
    // 出生区(世界左侧)
    if(ox<3*CELL){ ctx.fillStyle="rgba(63,140,95,.12)"; ctx.fillRect(0,0,3*CELL,VIEW_H); }
    // 右侧敌方区域标记
    if(ox+VIEW_W>WORLD_W-3*CELL){ ctx.fillStyle="rgba(140,50,50,.10)"; ctx.fillRect(WORLD_W-3*CELL,0,3*CELL,VIEW_H); }
  } else {
    // 营地网格
    for(let x=0;x<=VIEW_W;x+=CELL){ ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,VIEW_H); ctx.stroke(); }
    for(let y=0;y<=VIEW_H;y+=CELL){ ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(VIEW_W,y); ctx.stroke(); }
  }
  // 战场/营地装饰
  if(view==="battle"){
    // 战斗视角: 单位/平民在下方绘制
  } else {
    // 营地静态装饰: 建筑槽位 (与 bldLayout 同步, 保证点击命中)
    bldRects=bldLayout();
    bldRects.forEach(r=>{
      const b=BUILDINGS.find(x=>x.id===r.id);
      const lv=S.bld[b.id];
      const x=r.x,y=r.y;
      const sp=SPR.bld[b.id]?SPR.bld[b.id][lv]:null;
      if(sp){
        // 像素建筑: 48x42 居中于 64x64 槽位, 未建时半透明
        ctx.globalAlpha=lv>0?1:0.45;
        ctx.drawImage(sp, x+(r.w-48)/2, y+(r.h-42)/2, 48, 42);
        ctx.globalAlpha=1;
      }
      ctx.font="11px monospace"; ctx.textAlign="left";
      ctx.fillStyle=lv>0?"#8ce6a0":"#ffd75a";
      const tag=lv>0?("Lv"+lv):("建 💰"+b.cost[0]);
      ctx.fillText(tag,x+4,y+r.h-6);
    });
    ctx.font="11px monospace"; ctx.textAlign="center"; ctx.fillStyle="#c8d8b8";
    ctx.fillText("点击建筑槽位可直接建造 / 升级",VIEW_W/2,VIEW_H-CELL*0.4);
  }
  // 单位 (战斗视角加裁剪: 只画可见区, 像素 sprite)
  const inView=(x,y,pad)=>{ pad=pad||40; return x>=ox-pad&&x<=ox+VIEW_W+pad&&y>=oy-pad&&y<=oy+VIEW_H+pad; };
  const hpBar=(x,y,hp,maxHp)=>{
    if(!maxHp)return;
    ctx.fillStyle="#0a1410"; ctx.fillRect(x-14,y+14,28,4);
    ctx.fillStyle=hp/maxHp>0.4?"#37a3ff":"#ff6f6f";
    ctx.fillRect(x-14,y+14,28*Math.max(0,hp/maxHp),4);
  };
  if(view==="battle"){
    enemies.forEach(en=>{ if(!en.alive)return; if(!inView(en.x,en.y))return;
      const sp=SPR.zombie[en.t];
      if(sp) drawSprite(ctx,sp,en.x-18,en.y-24,36,42,en.flash);
      hpBar(en.x,en.y,en.hp,en.maxHp||ENEMY_DEF[en.t].hp);
    });
    soldiers.forEach(s=>{ if(!s.alive)return; if(!inView(s.x,s.y))return;
      const sp=SPR.soldier[s.type];
      if(sp) drawSprite(ctx,sp,s.x-18,s.y-24,36,42,s.flash);
      hpBar(s.x,s.y,s.hp,CREO_DEF[s.type].hp);
    });
    // 平民(战斗)
    if(civ&&inView(civ.x,civ.y)){
      if(SPR.civ) drawSprite(ctx,SPR.civ,civ.x-15,civ.y-21,30,42,0);
      hpBar(civ.x,civ.y,civ.hp,60);
    }
  } else {
    // 营地里士兵站立
    for(let i=0;i<3;i++){
      const x=(4+i*1.5)*CELL, y=VIEW_H-CELL*2.5;
      const sp=SPR.soldier[i];
      if(sp) ctx.drawImage(sp,x-18,y-24,36,42);
    }
  }
  // 特效
  fx.forEach(f=>{
    if(f.line){ if(!inView(f.x,f.y)&&!inView(f.tx,f.ty))return; ctx.strokeStyle=f.color; ctx.lineWidth=2; ctx.globalAlpha=Math.max(0,f.life/0.12); ctx.beginPath(); ctx.moveTo(f.x,f.y); ctx.lineTo(f.tx,f.ty); ctx.stroke(); ctx.globalAlpha=1; }
    else { if(!inView(f.x,f.y))return; ctx.fillStyle=f.color; ctx.globalAlpha=Math.max(0,f.life*2); ctx.fillRect(f.x-3,f.y-3,6,6); ctx.globalAlpha=1; f.x+=f.vx*dt; f.y+=f.vy*dt; }
  });
  // 点击涟漪反馈(世界坐标)
  if(tapMarker){
    tapMarker.life-=dt;
    if(tapMarker.life<=0) tapMarker=null;
    else{
      const pr=20*(1-tapMarker.life/0.5)+8;
      ctx.strokeStyle="rgba(255,215,90,"+(tapMarker.life/0.5).toFixed(2)+")";
      ctx.lineWidth=2; ctx.beginPath(); ctx.arc(tapMarker.x,tapMarker.y,pr,0,Math.PI*2); ctx.stroke();
    }
  }
  // 目标准星
  if(view==="battle"){
    soldiers.forEach(s=>{
      if(!s.alive||!s.target||!s.target.alive) return;
      if(!inView(s.target.x,s.target.y))return;
      ctx.strokeStyle="rgba(255,111,111,.85)"; ctx.lineWidth=1.5;
      const tx=s.target.x, ty=s.target.y;
      ctx.beginPath(); ctx.arc(tx,ty,16,0,Math.PI*2); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(tx-20,ty); ctx.lineTo(tx-10,ty); ctx.moveTo(tx+10,ty); ctx.lineTo(tx+20,ty);
      ctx.moveTo(tx,ty-20); ctx.lineTo(tx,ty-10); ctx.moveTo(tx,ty+10); ctx.lineTo(tx,ty+20); ctx.stroke();
    });
    // 玩家指挥指示: 士兵脚下显示其朝向(玩家指令=蓝绿, 自动推进=灰)
    soldiers.forEach(s=>{
      if(!s.alive)return; if(!inView(s.x,s.y))return;
      ctx.strokeStyle=s.cmdHold>0?"rgba(80,200,255,.9)":"rgba(160,200,180,.5)";
      ctx.lineWidth=2;
      ctx.beginPath(); ctx.moveTo(s.x,s.y+16); ctx.lineTo(s.x,s.y+26); ctx.stroke();
    });
  }
  ctx.restore();   // 退出世界坐标
  // 小地图(战斗视角, 屏幕空间右上角)
  if(isBattle) drawMinimap(ctx);
  if(paused){ ctx.fillStyle="rgba(6,12,8,.6)"; ctx.fillRect(0,0,VIEW_W,VIEW_H); ctx.fillStyle="#ffd75a"; ctx.font="20px monospace"; ctx.textAlign="center"; ctx.fillText("⏸ 暂停",VIEW_W/2,VIEW_H/2); }
}
/* 小地图: 显示整个战场 + 摄像机框, 帮助玩家理解跟随视野 */
function drawMinimap(ctx){
  const mw=150, mh=Math.round(mw*WORLD_H/WORLD_W); // 按比例
  const mx=VIEW_W-mw-8, my=8;
  ctx.fillStyle="rgba(10,20,16,.75)"; ctx.fillRect(mx,my,mw,mh);
  ctx.strokeStyle="rgba(140,230,160,.5)"; ctx.lineWidth=1; ctx.strokeRect(mx,my,mw,mh);
  const sx=mw/WORLD_W, sy=mh/WORLD_H;
  // 敌人
  ctx.fillStyle="#ff6f6f";
  enemies.forEach(en=>{ if(!en.alive)return; ctx.fillRect(mx+en.x*sx-1,my+en.y*sy-1,3,3); });
  // 士兵
  ctx.fillStyle="#8ce6a0";
  soldiers.forEach(s=>{ if(!s.alive)return; ctx.fillRect(mx+s.x*sx-1,my+s.y*sy-1,3,3); });
  // 平民
  if(civ&&civ.hp>0){ ctx.fillStyle="#ffe8a0"; ctx.fillRect(mx+civ.x*sx-1,my+civ.y*sy-1,4,4); }
  // 摄像机视野框
  ctx.strokeStyle="#ffd75a"; ctx.lineWidth=1;
  ctx.strokeRect(mx+camX*sx,my+camY*sy,VIEW_W*sx,VIEW_H*sy);
}
function drawCampStatic(){ /* 渲染已并入主循环 */ }
/* ==================== 缩放画布 ==================== */
function fitCanvas(){
  // 关键: 同步 canvas 内部分辨率(世界坐标 960x560), 否则单位/网格全画在默认 300x150 坐标系外 → 看不到士兵
  if(cv.width!==VIEW_W||cv.height!==VIEW_H){ cv.width=VIEW_W; cv.height=VIEW_H; }
  const wrap=cv.parentElement;
  const r=wrap.getBoundingClientRect();
  if(r.width<10||r.height<10) return;
  const scale=Math.min(r.width/VIEW_W, r.height/VIEW_H);
  cv.style.setProperty("width",Math.floor(VIEW_W*scale)+"px","important");
  cv.style.setProperty("height",Math.floor(VIEW_H*scale)+"px","important");
}
window.addEventListener("resize",fitCanvas);
window.addEventListener("orientationchange",()=>setTimeout(fitCanvas,200));
// 首次布局后再校准一次(确保 rAF 启动时画布尺寸已定)
if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",()=>setTimeout(fitCanvas,0));
else setTimeout(fitCanvas,0);
/* ==================== 按钮 ==================== */
document.getElementById("btnDeploy").onclick=deploy;
document.getElementById("btnWeapon").onclick=()=>{ const i=WEAPONS.findIndex(w=>w.id===S.weapon); S.weapon=WEAPONS[(i+1)%WEAPONS.length].id; renderCamp(); };
document.getElementById("btnGrenade").onclick=()=>useSkill("grenade");
document.getElementById("btnRacket").onclick=()=>useSkill("racket");
document.getElementById("btnPause").onclick=()=>{ paused=!paused; document.getElementById("btnPause").textContent=paused?"▶":"⏸"; };
document.getElementById("btnSave").onclick=save;
document.getElementById("btnReset").onclick=()=>{ if(confirm("确定重开?存档将清除")) resetAll(); };
document.getElementById("btnStart").onclick=()=>{ document.getElementById("onboard").style.display="none"; fitCanvas(); const g=offlineGain(); if(g>0) toast("离线"+g+"小时资源已结算"); renderCamp(); requestAnimationFrame(loop); };
/* 医疗站治疗快捷键(营地层点击士兵) 简化为自动 */
/* ==================== 启动 ==================== */
S=newState(); load(); fitCanvas();
if(!localStorage.getItem(LS_KEY)){ document.getElementById("onboard").style.display="flex"; }
else { document.getElementById("onboard").style.display="none"; const g=offlineGain(); if(g>0) setTimeout(()=>toast("离线"+g+"小时资源已结算"),300); renderCamp(); requestAnimationFrame(loop); }
</script>
</body>
</html>

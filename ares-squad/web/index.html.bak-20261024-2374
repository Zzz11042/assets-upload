/* ---- 战斗逻辑 ---- */
function updateBattle(dt){
  battleT+=dt;
  // 摄像机跟随小队质心(或平民): 小队保持在视野中部偏左, 右侧留给推进/来敌
  {
    let sx=0,sy=0,n=0;
    soldiers.forEach(s=>{ if(s.alive){sx+=s.x;sy+=s.y;n++;} });
    if(civ&&civ.hp>0){ sx+=civ.x; sy+=civ.y; n++; }
    if(n>0){ sx/=n; sy/=n; } else { sx=VIEW_W*0.3; sy=VIEW_H*0.5; }
    // 关键: 摄像机不能"抛下"任何单位(士兵/平民):
    //   视口左缘 ≤ 最左单位 (camX ≤ minX) → 最左单位不会跑到屏外左侧
    //   视口右缘 ≥ 最右单位 (camX+VIEW_W ≥ maxX, 即 camX ≥ maxX-VIEW_W) → 最右单位不会跑到屏外右侧
    // 用 0.25 视口边距收紧, 让单位不贴边
    let minX=1e9,maxX=-1e9,minY=1e9,maxY=-1e9;
    soldiers.forEach(s=>{ if(!s.alive)return; minX=Math.min(minX,s.x);maxX=Math.max(maxX,s.x);minY=Math.min(minY,s.y);maxY=Math.max(maxY,s.y); });
    if(civ&&civ.hp>0){ minX=Math.min(minX,civ.x);maxX=Math.max(maxX,civ.x);minY=Math.min(minY,civ.y);maxY=Math.max(maxY,civ.y); }
    const padX=VIEW_W*0.25, padY=VIEW_H*0.25;
    // 上界: 最左单位留在屏内 (camX ≤ minX-padX, 即最左单位距左缘≥0)
    // 下界: 最右单位留在屏内 (camX ≥ maxX+padX-VIEW_W)
    let lo=Math.max(0, maxX+padX-VIEW_W);
    let hi=Math.min(WORLD_W-VIEW_W, minX-padX);
    let loY=Math.max(0, maxY+padY-VIEW_H);
    let hiY=Math.min(WORLD_H-VIEW_H, minY-padY);
    // 上下界倒置时(单位太密集放不下整屏)退化为小队质心居中
    const sxv=lo>=hi?(lo+hi)/2:Math.max(lo,Math.min(hi, sx-VIEW_W*0.45));
    const syv=loY>=hiY?(loY+hiY)/2:Math.max(loY,Math.min(hiY, sy-VIEW_H*0.5));
    const k=Math.min(1,dt*4);   // 平滑跟随
    camX+=(sxv-camX)*k; camY+=(syv-camY)*k;
    // 最终兜底: 摄像机永远不越出世界
    camX=Math.max(0,Math.min(WORLD_W-VIEW_W,camX));
    camY=Math.max(0,Math.min(WORLD_H-VIEW_H,camY));
    // 护送关特殊兜底: 若 civ 已比"摄像机右缘-边距"更靠右(说明 civ 在往出口推进), 强制把摄像机
    // 推到能容纳 civ 的位置(不抛下 civ), 同时不把 civ 钳到屏幕外(40px 出屏容差)
    if(civ&&civ.hp>0&&mCurBg==="tunnel"){
      const m=40;
      if(civ.x>camX+VIEW_W-m){ camX=Math.max(0,Math.min(WORLD_W-VIEW_W, civ.x-(VIEW_W-m))); civ.x=Math.min(civ.x,camX+VIEW_W-m); }
      if(civ.x<camX+m){ camX=Math.max(0,Math.min(WORLD_W-VIEW_W, civ.x-m)); civ.x=Math.max(civ.x,camX+m); }

        ctx.globalAlpha=1;
      }
      ctx.font="11px monospace"; ctx.textAlign="left";
      ctx.fillStyle=lv>0?"#8ce6a0":"#ffd75a";
      const tag=lv>0?("Lv"+lv):("建 💰"+b.cost[0]);
      ctx.fillText(tag,x+4,y+r.h-6);
    });
    ctx.font="11px monospace"; ctx.textAlign="center"; ctx.fillStyle="#c8d8b8";
    ctx.fillText("点击建筑槽位可直接建造 / 升级",VIEW_W/2,VIEW_H-CELL*0.4);
  }
  // 单位 (战斗视角加裁剪: 只画可见区, 像素 sprite)
  // culling 按 sprite 包围盒(44x52 + 16 余量 → pad 80), 贴缘单位不会被裁一半
  const inView=(x,y,pad)=>{ pad=pad||80; return x>=ox-pad&&x<=ox+VIEW_W+pad&&y>=oy-pad&&y<=oy+VIEW_H+pad; };
  const hpBar=(x,y,hp,maxHp,sh)=>{
    if(!maxHp)return;
    // 血条贴单位头顶: 按 sprite 实际高(sh)计算, 顶边 = y - sh/2
    // 第 16 轮: 加宽血条 + 三段色阶(绿>60% / 黄30-60% / 红<30%) + 细描边 + 低血量闪烁
    const bh=5, bw=52, ratio=Math.max(0,hp/maxHp), fill=ratio*bw;

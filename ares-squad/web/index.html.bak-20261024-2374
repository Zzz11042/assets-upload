// 免费弹药补给站像素 sprite(18x16): 橙色弹药箱 + 子弹 + "AMMO" 标识 — 第 16 轮优化: 箱体高光/铆钉
function makeAmmoStation(){
  return makeSprite(18,16,(g,px)=>{
    const c=OUTLINE, box="#c87a3a", boxD="#8a4a1a", boxL="#e89a5a", band="#e0a84a", bullet="#ffd75a", bulletD="#c8a83a";
    // 底座阴影
    for(let i=4;i<14;i++){ px(i,14,c); px(i,15,c); }
    // 箱体
    for(let y=4;y<14;y++)for(let x=3;x<15;x++) px(x,y, (x===3||x===14||y===4||y===13)?c:((x>=8&&x<=9&&y>=6&&y<=8)?band:box));
    // 箱体左上高光
    for(let y=5;y<13;y++){ px(4,y,boxL); }
    // 箱体铆钉
    px(4,4,boxD);px(13,4,boxD);px(4,13,boxD);px(13,13,boxD);
    // 弹药带
    px(8,6,band);px(9,6,band);px(8,7,band);px(9,7,band);
    // 子弹(2 发斜放 + 高光)
    px(6,8,bullet);px(7,8,bullet);px(6,9,bulletD);
    px(10,8,bullet);px(11,8,bullet);px(11,9,bulletD);
    px(6,8,"#fff8d0");  // 子弹高光
    // 顶部盖子
    for(let x=4;x<14;x++) px(x,3,(x===4||x===13)?c:boxD);
    for(let x=5;x<13;x++) px(x,3,boxL);  // 盖子上沿高光
    // AMMO 标识(3 个白色点代表字母位置)
    px(5,5,"#fff");px(8,5,"#fff");px(11,5,"#fff");
  });
}
function drawUnit(g,t,x,y,flash){
  // 按僵尸类型选择 sprite 与包围盒(crawler 更矮更宽, tank 更宽); 第 16 轮 sprite 放大一档
  const sp=SPR.zombie[t];
  const sh=(t==="crawler")?44:((t==="tank")?60:56), sw=(t==="crawler")?56:((t==="tank")?60:48);
  if(sp) drawSprite(g,sp,x-sw/2,y-sh/2,sw,sh,flash);
  return sh;
}

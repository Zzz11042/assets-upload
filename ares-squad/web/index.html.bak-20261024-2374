    // 约束: 士兵始终保持在镜头可视区内(不出屏), 因此只追"视野内"的敌人
    // 例外: 若主武器打空且非手枪, 自动去最近的免费补给点补弹(而不是傻追敌人挨打)
    // 保卫/无尽模式: 士兵被围墙封闭在出生区内, 自动推进/补弹目标也截断到出生区内(不追着外头的敌人跑)
    const mainWep=CREO_DEF[s.type].wep[0];
    const needResupply = mainWep!=="pistol" && (s.ammo[mainWep]|0)<=0;
    const clmp=(v,lo,hi)=>Math.max(lo,Math.min(hi,v));
    const toBase=(x,y)=> walls.length>0 ? {x:clmp(x,BASE_SPAWN.x0,BASE_SPAWN.x1),y:clmp(y,BASE_SPAWN.y0,BASE_SPAWN.y1)} : {x,y};
    if(needResupply && ammoStations.length>0 && s.tx==null && s.ty==null && s.cmdHold<=0){
      // 自动去补给点(取视野内最近一个, 出视野则取最近全场); 保卫/无尽模式下补给点在出生区内
      let bs=null,bsd=1e9;
      ammoStations.forEach(st=>{ const dd=Math.hypot(st.x-s.x,st.y-s.y); if(dd<bsd){bsd=dd;bs=st;} });
      if(bs){
        const p=toBase(bs.x,bs.y);
        s.tx=Math.max(camX+CELL,Math.min(camX+VIEW_W-CELL,p.x));
        s.ty=Math.max(camY+CELL,Math.min(camY+VIEW_H-CELL,p.y));
      }
    } else if(s.tx==null&&s.ty==null&&s.cmdHold<=0){
      let bt=null,bd=1e9;
      const inView=(x,y,pad)=>{ pad=pad||0; return x>=camX-pad&&x<=camX+VIEW_W+pad&&y>=camY-pad&&y<=camY+VIEW_H+pad; };
      for(const en of enemies){ if(!en.alive||!inView(en.x,en.y)) continue;
        const dd=Math.hypot(en.x-s.x,en.y-s.y);
        if(dd<bd){bd=dd;bt=en;}
      }
      if(bt){
        s.target=bt;
        // 推进到"当前武器有效射程"内(手枪 200 / 步枪 240 / 狙击 420); 所有射程 > 最远近战僵尸 100
        const wdAdv=WEAPONS.find(w=>w.id===s.wep)||WEAPONS[0];
        const effR=Math.min(d.range, wdAdv.range||d.range);
        const ed=ENEMY_DEF[bt.t];
        // 安全停火线 = 该敌人近战扑咬距离 + 40px; 投掷者(360 酸弹)除外, 用其 1/4 射程(90px)作停火线
        // 这样士兵不会贴脸吃近战; 若目标已比停火线更近, 自动后撤到停火线(保持安全距离)
        const edRange=ed.range||60;
        const isThrower=(bt.t==="thrower");
        const stop=isThrower?Math.min(90,edRange*0.3):Math.min(edRange+40, Math.max(120, edRange));
        if(bd>stop){
          // 在停火线外 → 向目标推进到停火线(保卫/无尽模式下截断到出生区内)
          const dirx=(bt.x-s.x)/(bd||1), diry=(bt.y-s.y)/(bd||1);
          let nx=s.x+dirx*stop, ny=s.y+diry*stop;
          const pp=toBase(nx,ny);
          nx=Math.max(camX+CELL,Math.min(camX+VIEW_W-CELL,pp.x));
          ny=Math.max(camY+CELL,Math.min(camY+VIEW_H-CELL,pp.y));
          s.tx=nx; s.ty=ny;
        } else if(bd<stop*0.6){
          // 已比停火线更近 → 后撤到停火线(保持安全距离, 不贴脸); 后撤目标钳制在镜头可视区内(不出屏)
          const dirx=(s.x-bt.x)/(bd||1), diry=(s.y-bt.y)/(bd||1);
          let nx=s.x+dirx*(stop-bd), ny=s.y+diry*(stop-bd);
          const pp=toBase(nx,ny);
          nx=Math.max(camX+CELL,Math.min(camX+VIEW_W-CELL,pp.x));
          ny=Math.max(camY+CELL,Math.min(camY+VIEW_H-CELL,pp.y));
          s.tx=nx; s.ty=ny;
        } else { s.tx=null; s.ty=null; } // 在停火线 ±40% 内→原地输出
      } else s.target=null;
    }
    // 边走边打: 玩家移动指令(cmdHold>0)期间, 若"集火目标"已失效且附近有敌人(武器射程内), 自动开火
    // —— 不会擅自改道(保持玩家指令), 但不会傻走过去挨打
    if(s.cmdHold>0&&!s.target){
      let bt=null,bd=1e9;
      const inV=(x,y)=>x>=camX&&x<=camX+VIEW_W&&y>=camY&&y<=camY+VIEW_H;
      const wd0=WEAPONS.find(w=>w.id===s.wep)||WEAPONS[0];
      const effRange0=Math.min(d.range, wd0.range||d.range);
      for(const en of enemies){ if(!en.alive||!inV(en.x,en.y))continue;
        const dd=Math.hypot(en.x-s.x,en.y-s.y);
        if(dd<effRange0&&dd<bd){bd=dd;bt=en;}
      }
      if(bt) s.target=bt;
    }
    // 攻击 (目标已在循环顶部校验: 仅存活且HP>0 的敌人)
    // 减速中(被尖叫者声波): 攻速 ×0.6, 每帧追加冷却
    if(s.slowT>0){ s.cd+=dt*0.4; }
    const wd=WEAPONS.find(w=>w.id===s.wep)||WEAPONS[0];
    // 弹药系统: 主武器消耗弹药; 打空自动进入"换弹"(按武器 reload), 换弹完成自动切副武器手枪(pistol 不限量)
    // 没子弹就只能用手枪; 机枪手弹药更足(mg 60)火力猛但行动迟缓(移速 70)
    if(s.reloadT>0){
      s.reloadT-=dt;
      if(s.reloadT<=0){
        // 换弹完成: 主武器还有弹药就继续, 否则切副武器手枪(不限量, 射程 200 短)
        const remaining=(s.ammo||{})[s.wep]||0;
        if(s.wep!=="pistol"&&remaining<=0){
          s.wep="pistol"; s.cd=0.3;
          fx.push({x:s.x,y:s.y,life:0.4,color:"#ffd75a",text:"换手枪"});
        }
      }
      // 换弹中: 跳过开火, 但仍可移动(边走边换弹)
    } else if(s.cd<=0){
      let tgt=s.target;
      const isPistol=(wd.id==="pistol");
      const ammoOk=isPistol||((s.ammo||{})[wd.id]>0);
      if(!ammoOk){
        // 弹药耗尽: 进入换弹(按武器 reload), 期间不开火, 换完切手枪
        s.reloadT=wd.reload||1.2;
        s.cd=0;
        fx.push({x:s.x,y:s.y,life:0.6,color:"#888",text:"换弹"});
      } else if(tgt&&tgt.alive){
        // 有效射程: 取兵种射程与武器射程的较小值
        const effRange=Math.min(d.range, wd.range||d.range);
        const distT=Math.hypot(tgt.x-s.x,tgt.y-s.y);
        if(distT<=effRange){
          // 伤害: 各兵种主武器自带特性(狙击破甲 / 医疗回血 / 工程造机枪 / 机枪密集)
          let dmg=d.atk*(s.atkBoost||1)*(wd.atk||1);
          if(wd.id==="snipe"&&tgt.armor) dmg+=8;                 // 狙击手破甲
          tgt.hp-=dmg;
          if(tgt.hp<1){ tgt.hp=0; } // 消除浮点残血
          tgt.flash=0.15;
          // 火箭筒: 溅射伤害(80px 内其他敌 50% 伤害) + 爆炸特效
          if(wd.splash){
            enemies.forEach(en2=>{ if(en2.alive&&en2!==tgt&&Math.hypot(en2.x-tgt.x,en2.y-tgt.y)<wd.splash){ en2.hp-=dmg*0.5; en2.flash=0.15; } });
            fx.push({x:tgt.x,y:tgt.y,life:0.4,color:"#ff6f3a",r:wd.splash});
          }
          s.cd=wd.cd||d.rate/100;   // 武器射速(机枪 0.12s 极快 / 步枪 0.28s / 狙击 1.6s / 医疗 1.4s / 工程 1.0s)
          // 弹药扣减(非手枪); 扣到 0 后下帧自动进入换弹
          if(!isPistol){ s.ammo[wd.id]=(s.ammo[wd.id]|0)-1; if(s.ammo[wd.id]<0)s.ammo[wd.id]=0; }
          // 医疗兵: 命中自身或最近友军回血(急救枪特性)
          if(wd.heal){
            let healTarget=s; let bestHp=-1;
            soldiers.forEach(o=>{ if(o.alive&&o.hp<o.hp_max*0.7&&o.hp>bestHp&&Math.hypot(o.x-s.x,o.y-s.y)<160){bestHp=o.hp;healTarget=o;} });
            healTarget.hp=Math.min(healTarget.hp_max||CREO_DEF[healTarget.type].hp, healTarget.hp+wd.heal);
            fx.push({x:healTarget.x,y:healTarget.y,life:0.5,color:"#8affd0"});
          }
          // 工程师: 开火时概率造一座哨戒机枪(工程枪特性, 限 4 座)
          if(wd.turret && Math.random()<0.06 && turrets.filter(tu=>tu.hp>0).length<4){
            turrets.push({x:s.x,y:s.y,hp:200,maxHp:200,cd:0,range:280,atk:18,place:false});
            fx.push({x:s.x,y:s.y,life:0.6,color:"#ffd75a"});
          }
          // 弹道特效(武器各异: 手枪灰/狙击黄/机枪橙/医疗绿/工程蓝/火箭红/高斯紫)
          const wcol={pistol:"#9a9a8a",snipe:"#ffd75a",mg:"#ff9a3a",medgun:"#8affd0",egun:"#5ad0ff",rocket:"#ff4a3a",gauss:"#c88aff"}[wd.id]||(s.type===2?"#ffd75a":"#8ce6a0");
          fx.push({x:s.x,y:s.y,tx:tgt.x,ty:tgt.y,line:true,life:0.12,color:wcol});
        }
      }
    }
  });
  // 哨戒机枪自动开火(防御任务): 射程内最近敌人, 射速 0.4s/发, 优先集火"装甲怪/僵尸王"(高威胁)
  turrets.forEach(tu=>{
    if(tu.hp<=0)return;
    tu.cd-=dt;
    if(tu.cd>0)return;
    let bt=null,bd=1e9,bScore=-1;
    enemies.forEach(en=>{ if(!en.alive)return;
      const dd=Math.hypot(en.x-tu.x,en.y-tu.y);
      if(dd>tu.range)return;
      // 集火优先级: 装甲怪/僵尸王(厚甲高威胁) > 近处
      const score=(en.armor||0)*10 + Math.max(0,300-dd);
      if(score>bScore){bScore=score;bt=en;bd=dd;}
    });
    if(bt){
      bt.hp-=tu.atk; if(bt.hp<1)bt.hp=0;
      bt.flash=0.15;
      tu.cd=0.4;
      fx.push({x:tu.x,y:tu.y,tx:bt.x,ty:bt.y,line:true,life:0.12,color:"#ffd75a"});
    }
  });
  // 敌人
  enemies.forEach(en=>{
    if(!en.alive) return;
    en.flash=Math.max(0,en.flash-dt);
    en.cd-=dt;
    if(en.stunT>0){ en.stunT-=dt; return; }  // 电击定身: 本帧不行动
    // 目标: 士兵/平民/哨戒机枪(防御任务)
    let target=null, targetDist=1e9;
    if(civ){ const dc=Math.hypot(civ.x-en.x,civ.y-en.y); if(dc<targetDist){targetDist=dc;target=civ;} }
    soldiers.forEach(s=>{ if(s.alive){ const d2=Math.hypot(s.x-en.x,s.y-en.y); if(d2<targetDist){targetDist=d2;target=s;} }});
    turrets.forEach(tu=>{ if(tu.hp>0){ const d3=Math.hypot(tu.x-en.x,tu.y-en.y); if(d3<targetDist){targetDist=d3;target=tu;} }});
    if(target){
      const dx=target.x-en.x, dy=target.y-en.y, dist=Math.hypot(dx,dy)||1;
      // 爬行者: 高速贴脸; 尖叫者: 保持距离 + 周期性声波(200px 内减速 40%, 0.5s)
      const isCrawler=(en.t==="crawler");
      const isScreamer=(en.t==="screamer");
      const isThrower=(en.t==="thrower");
      const isBoomer=(en.t==="boomer");
      const isDropper=(en.t==="dropper");
      const moveRange=isCrawler?en.range:(isThrower?en.range*0.9:(isScreamer?en.range*1.2:en.range*0.7));
      // 空降兵: 伞降阶段(悬浮 3.5s, 带伞), 不移动/不啃墙, 落地后切换突袭行为
      if(isDropper){
        if(en.flyingT==null)en.flyingT=ENEMY_DEF.dropper.flying||3.5;
        en.flyingT-=dt;
        if(en.flyingT>0){ en.flying=true; return; }  // 伞降中
        en.flying=false;
        // 落地后: 高速突袭最近目标(移速×1.4)
        en.speedBase=en.speedBase||en.speed;
        en.speed=en.speedBase*1.4;
      }
      // 自爆兵: 高速冲脸, 接触目标(≤20px)即引爆(60 伤害, 70px 溅射)
      if(isBoomer&&dist<=24){
        en.alive=false;
        // 爆炸溅射: 70px 内士兵/哨戒机枪
        fx.push({type:"boom",x:en.x,y:en.y,r:ENEMY_DEF.boomer.bombR||70,life:0.5,color:"#ff8a3a"});
        soldiers.forEach(s=>{ if(s.alive&&Math.hypot(s.x-en.x,s.y-en.y)<(ENEMY_DEF.boomer.bombR||70)){ s.hp-=ENEMY_DEF.boomer.bomb||60; s.flash=0.3; } });
        turrets.forEach(tu=>{ if(tu.hp>0&&Math.hypot(tu.x-en.x,tu.y-en.y)<(ENEMY_DEF.boomer.bombR||70)){ tu.hp-=ENEMY_DEF.boomer.bomb||60; tu.flash=0.3; } });
        S.gold+=8;
        return;
      }
      // 保卫战/无尽模式: 僵尸被围墙阻挡 — 不能穿墙, 贴墙先啃墙, 破墙才入基地
      // 僵尸碰撞盒(略小于视觉尺寸), 用于墙体碰撞检测
      const zHalfW=30, zHalfH=(en.t==="crawler")?24:30;
      const resolveWall=(x,y)=>{
        if(walls.length===0)return{x,y,hit:null};
        for(const wl of walls){ if(!wl.alive)continue;
          // 墙扩展碰撞区(僵尸中心不能进入): 墙外沿 ± zHalf
          const px0=wl.x-zHalfW, px1=wl.x+wl.w+zHalfW, py0=wl.y-zHalfH, py1=wl.y+wl.h+zHalfH;
          if(x>px0&&x<px1&&y>py0&&y<py1){
            // 用僵尸相对墙中心的位置决定推哪侧(确定性, 避免抖动):
            // 在墙左半 → 推到墙左侧外沿; 在墙右半 → 推到右侧外沿; 上半 → 上沿; 下半 → 下沿
            const cwx=wl.x+wl.w/2, cwy=wl.y+wl.h/2;
            const onLeftHalf=x<cwx, onTopHalf=y<cwy;
            // 横墙(w>h): 主要按上下推; 竖墙(w<h): 主要按左右推
            const isVWall=(wl.w<wl.h);
            if(isVWall){ if(onLeftHalf)x=px0; else x=px1; }
            else { if(onTopHalf)y=py0; else y=py1; }
            return{x,y,hit:wl};
          }
        }
        return{x,y,hit:null};
      };
      // 贴墙啃墙(距墙 ≤ 40px): 优先攻击最近一面活墙(1s 冷却, 高伤)
      let wallBlock=null, wallD=1e9;
      if(walls.length>0){
        walls.forEach(wl=>{ if(!wl.alive)return;
          const inBase = (en.x<wl.x+wl.w && en.x>wl.x && en.y>wl.y && en.y<wl.y+wl.h);
          const cx=Math.max(wl.x,Math.min(wl.x+wl.w,en.x));
          const cy=Math.max(wl.y,Math.min(wl.y+wl.h,en.y));
          const dWall=Math.hypot(cx-en.x,cy-en.y);
          if(dWall<wallD&&!inBase){wallD=dWall;wallBlock=wl;}
        });
        // 贴墙(距墙 ≤ 40px) → 啃墙(1s 冷却, 高伤), 本帧不移动/不扑咬士兵
        if(wallBlock&&wallD<=40&&en.cd<=0){
          en.cd=1;
          wallBlock.hp-=Math.max(2,en.atk*1.5);
          wallBlock.flash=0.15;
          if(wallBlock.hp<1){ wallBlock.alive=false; fx.push({x:wallBlock.x+wallBlock.w/2,y:wallBlock.y+wallBlock.h/2,life:0.6,color:"#8a4a2a",text:"墙塌了!"}); }
        }
      }
      // 朝目标推进: 被墙挡住则停在墙外(碰撞推出 + 无冷却啃墙)
      // 关键: 僵尸始终朝目标探一步, 贴墙时啃墙破墙(不扑咬墙后的士兵)
      let blockedByWall=false;
      {
        const step=Math.min(en.speed*dt, dist+20);
        let nx=en.x+dx/dist*step, ny=en.y+dy/dist*step;
        const r=resolveWall(nx,ny);
        en.x=r.x; en.y=r.y;
        // 被墙推回时(贴墙): 无冷却啃墙(累计破墙, 数值= 每秒 atk*1.2)
        if(r.hit&&r.hit.hp>0){
          r.hit.hp-=en.atk*1.2*dt; r.hit.flash=0.1;
          if(r.hit.hp<1){ r.hit.alive=false; fx.push({x:r.hit.x+r.hit.w/2,y:r.hit.y+r.hit.h/2,life:0.6,color:"#8a4a2a",text:"墙塌了!"}); }
          blockedByWall=true;
        }
      }
      // 被墙挡住: 啃墙破墙中, 本帧不扑咬墙后的士兵
      if(blockedByWall){ return; }
      // 僵尸在墙外且目标是墙内 → 啃最近墙(40px 内), 不扑咬墙后的士兵
      if(walls.length>0){
        let outside=true, chewWall=null, chewD=1e9;
        walls.forEach(wl=>{ if(!wl.alive)return;
          const inW=(en.x>wl.x&&en.x<wl.x+wl.w&&en.y>wl.y&&en.y<wl.y+wl.h);
          if(inW)outside=false;
          const cx=Math.max(wl.x,Math.min(wl.x+wl.w,en.x));
          const cy=Math.max(wl.y,Math.min(wl.y+wl.h,en.y));
          const dWall=Math.hypot(cx-en.x,cy-en.y);
          if(dWall<chewD){chewD=dWall;chewWall=wl;}
        });
        if(outside&&chewWall&&chewD<=40){
          chewWall.hp-=Math.max(en.atk*0.4,en.atk*0.4); chewWall.flash=0.1;
          if(chewWall.hp<1){ chewWall.alive=false; fx.push({x:chewWall.x+chewWall.w/2,y:chewWall.y+chewWall.h/2,life:0.6,color:"#8a4a2a",text:"墙塌了!"}); }
          return; // 啃墙中, 本帧不扑咬士兵
        }
      }
      // 已到目标射程内 → 近战/技能(声波/酸弹/扑咬)
      if(isScreamer){
        // 声波 AoE: 冷却 2.4s, 180px 内士兵减速(攻速×0.6)+微量伤害(补给点内士兵无敌, 不受声波)
        const ed=ENEMY_DEF[en.t];
        if(en.cd<=0){
          en.cd=2.4;
          const R=ed.scream||180;
          soldiers.forEach(s=>{ if(!s.alive||s.safeT>0)return;
            if(Math.hypot(s.x-en.x,s.y-en.y)<R){ s.slowT=0.5; s.hp-=ed.atk*0.6; if(s.hp<1)s.hp=0; }});
          fx.push({x:en.x,y:en.y,life:0.5,color:"#c89ae0",vx:0,vy:0});
        }
      } else if(isThrower){
        // 投掷者: 远程投酸弹(抛物线), 命中 30px 内 8 伤害 + 3s 减速
        const ed=ENEMY_DEF[en.t];
        if(target&&en.cd<=0&&targetDist<360){
          en.cd=3.5;
          // 酸弹以 90px/s 飞向目标(记录起点, 在 fx 中模拟抛物线)
          const tx=target.x, ty2=target.y;
          const dist0=Math.hypot(tx-en.x,ty2-en.y)||1;
          const dur=dist0/90;
          fx.push({type:"acid",x:en.x,y:en.y,sx:en.x,sy:en.y,tx:tx,ty:ty2,dur:dur,age:0,life:dur,target:target,color:"#c8e04a"});
        }
      } else if(en.cd<=0){
        en.cd=1;
        if(target===civ){ civ.hp-=Math.max(1,en.atk); if(civ.hp<1)civ.hp=0; }
        else if(target.maxHp!==undefined){ target.hp-=Math.max(1,en.atk); target.flash=0.15; }   // 哨戒机枪
        else if(target.safeT>0){ target.flash=0; }   // 补给点保护中的士兵不吃近战伤害
        else { target.hp-=Math.max(1,en.atk); if(target.hp<1)target.hp=0; target.flash=0.15; }
      }
    }
    if(en.hp<1){
      en.alive=false;
      S.gold+= (en.t==="king"?80:10);
      S.part+= (en.t==="king"?2: (Math.random()<0.4?1:0));
      fx.push({x:en.x,y:en.y,life:0.4,color:"#ff6f6f"});
      // 孢子体: 死后喷孢子云(90px 范围, 5s 内进入者持续减速攻速×0.5)
      if(en.t==="spore"){ sporeZones.push({x:en.x,y:en.y,r:90,ttl:5}); }
    }
  });
  // 士兵阵亡判定
  soldiers.forEach(s=>{ if(s.alive&&s.hp<1){ s.alive=false; s.target=null; s.tx=null; s.ty=null; fx.push({x:s.x,y:s.y,life:0.5,color:"#556"}); } });
  // 阵亡即出局: 同步死标记到 S.crew(本局不再使用, 医疗站也不再复活)
  soldiers.forEach(s=>{ if(s.crewRef&&!s.alive)s.crewRef.dead=true; });
  fx.forEach(f=>f.life-=dt); fx=fx.filter(f=>f.life>0);
  sporeZones.forEach(z=>z.ttl-=dt); sporeZones=sporeZones.filter(z=>z.ttl>0);
  walls.forEach(wl=>{ if(wl.flash>0)wl.flash=Math.max(0,wl.flash-dt); });
  refreshHud();
  // 人质移动(护送): 玩家命令优先(点空地时人质同行), 无命令时以 120px/s(与士兵同速) 向右推进
  if(civ&&civ.hp>0){
    if(civ.tx!=null&&civ.ty!=null){
      // 玩家/队形指定目标: 朝目标走
      const dx=civ.tx-civ.x, dy=civ.ty-civ.y, dist=Math.hypot(dx,dy);
      if(dist>6){ civ.x+=dx/dist*Math.min(120*dt,dist); civ.y+=dy/dist*Math.min(120*dt,dist); }
      else civ.tx=civ.ty=null;
    } else {
      // 无指定目标: 继续往右推进到出口(护送关胜负点), 速度 120px/s
      civ.x+=120*dt;
    }
    // 钳制在镜头可视区内(不出屏, 40px 容差与出屏检测一致)
    const m=40;
    civ.x=Math.max(camX+m,Math.min(camX+VIEW_W-m,civ.x));
    civ.y=Math.max(camY+m,Math.min(camY+VIEW_H-m,civ.y));
    if(civ.x>=WORLD_W-CELL) civ.x=WORLD_W-CELL;
  }
  // 胜负
  const alive=soldiers.some(s=>s.alive);
  const m=(mCur&&mCur.mode)?mCur:MISSIONS[S.mission-1];   // 独立模式(保卫/无尽)用 mCur(带 mode), 主线用 MISSIONS
  if(m.type==="escort"){
    if(civ&&civ.x>=WORLD_W-CELL){ endBattle(true,"平民成功穿越!"); return; }
    if(civ&&civ.hp<=0){ endBattle(false,"平民被劫杀!"); return; }
  } else if(m.mode==="defense"){
    // 独立保卫战(先判, 避免 M8 45s 误判): 士兵全灭→输; 全部 totalSpawn 僵尸清完→推进下一波
    if(!soldiers.some(s=>s.alive)){ endBattle(false,"小队全灭!保卫战止步于 第"+(S.defWave+1)+" 波"); return; }
    if(spawnQueue.length===0 && !enemies.some(e=>e.alive) && battleTotalSpawn>=(m.totalSpawn||500)){ S.defWave++; endBattle(true,"守住 第"+S.defWave+" 波!(共斩 "+battleTotalSpawn+" 尸, 尸潮更猛, 继续迎战)"); return; }
  } else if(m.mode==="endless"){
    // 无尽模式: 按层推进, 每层更强敌人; 清完当前层(全部刷出)→解锁更强大武器/隐藏职业, 进入下一层
    if(!soldiers.some(s=>s.alive)){ endBattle(false,"小队全灭!无尽止步于 第"+(S.endlessTier+1)+" 层"); return; }
    if(spawnQueue.length===0 && !enemies.some(e=>e.alive) && battleTotalSpawn>=(m.totalSpawn||500)){ S.endlessTier++; endBattle(true,"突破 第"+S.endlessTier+" 层!(共斩 "+battleTotalSpawn+" 尸, 解锁更强大武器/隐藏职业)"); return; }
  } else if(m.type==="defend"){
    // 主线 M8 基地防御战: 守住 defend 秒 + 基地未被摧毁
    const baseAlive=soldiers.some(s=>s.alive)||turrets.some(t=>t.hp>0);
    if(!baseAlive){ endBattle(false,"前哨被攻陷!"); return; }
    if(battleT>=m.defend){ endBattle(true,"坚守 "+m.defend+"s,基地守住了!"); return; }
  } else {
    // 清剿: 小队全灭失败; 全歼+补尸上限达成后结束
    if(!soldiers.some(s=>s.alive)){ endBattle(false,"小队全灭!"); return; }
    if(battleRespawn>=8 && !enemies.some(e=>e.alive)){ endBattle(true,"区域已清剿!"); return; }
  }
  // 侦察类: 限时 60s 内坚持到点即完成(不需要全歼, 侦察目的达成)
  if(m.type==="scout"&&battleTimeLimit>0&&battleT>=battleTimeLimit){ endBattle(true,"侦察情报已传回!"); return; }
  // 清剿类战斗时长兜底: 90s 内没打完(被补尸拖住), 判定"坚守"胜利, 避免无限战斗(保卫/无尽模式不适用)
  if(m.type!=="escort"&&m.type!=="defend"&&!m.mode&&battleT>90){ endBattle(true,"坚守至援军到达!"); return; }
}
function endBattle(win,msg){
  inBattle=false; view="camp";
  document.getElementById("battleBar").style.display="none";
  document.getElementById("missionBanner").style.display="none";
  document.getElementById("campPanel").style.display="flex";
  // 按当前模式取任务: 主线=MISSIONS, 保卫/无尽=重算 startDefenseMode(波次/层数已推进)
  const m=(S.mode==="campaign")?MISSIONS[S.mission-1]:startDefenseMode();
  const box=document.getElementById("resultBox");
  if(win){
    if(S.mode==="campaign"){
      S.mission++; S.won++;
      // 每关固定 +200 金币(核心经济), 食物保底 ≥1(抵消出击耗粮), 零件保底 ≥1(工坊可用)
      S.gold+=200;
      const r=m.reward;
      const foodNet=Math.max(1,r.food); // 出击耗 1, 保底净 ≥1
      const partNet=Math.max(1,r.part);
      S.part+=partNet; S.food+=foodNet; S.med+=r.med;
      S.food=Math.max(0,S.food-1); // 出击耗粮
      // 解锁下一兵: 过 3/6/9 关后多 1 人
      ensureCrew();
      box.innerHTML="<h2>✅ 任务"+m.id+" 完成 · "+msg+"</h2>"+
        "奖励: 💰+200 🔩+"+partNet+" 🍖+"+foodNet+" 💊+"+r.med+"<br>"+
        (S.mission<=MISSIONS.length ? "下一任务: "+MISSIONS[S.mission-1].nm+" 已解锁" : "🏆 全部任务通关! 阿瑞斯病毒已终结");
    } else if(S.mode==="defense"){
      // 保卫战奖励: 金币/零件/食物按波次, 无主线推进
      const r={gold:80+(S.defWave||0)*30,part:2+(S.defWave||0),food:2,med:1};
      S.gold+=r.gold; S.part+=r.part; S.food+=r.food; S.med+=r.med;
      box.innerHTML="<h2>✅ "+msg+"</h2>"+
        "奖励: 💰+"+r.gold+" 🔩+"+r.part+" 🍖+"+r.food+" 💊+"+r.med+"<br>"+
        "保卫战 第"+(S.defWave||0)+" 波已守 · 尸潮更猛, 可继续迎战或转主线";
    } else {
      // 无尽模式: 解锁更强大武器/隐藏职业(层数 1=火箭筒/高斯步枪, 2=赏金猎人/幽灵)
      const r={gold:150+(S.endlessTier||0)*60,part:3+(S.endlessTier||0)*2,food:3,med:2};
      S.gold+=r.gold; S.part+=r.part; S.food+=r.food; S.med+=r.med;
      let unL="";
      if(S.endlessTier===1) unL="已解锁: 火箭筒+高斯步枪";
      if(S.endlessTier>=2) unL="已解锁: 赏金猎人(火箭筒)+幽灵(高斯步枪)职业";
      box.innerHTML="<h2>✅ "+msg+"</h2>"+
        "奖励: 💰+"+r.gold+" 🔩+"+r.part+" 🍖+"+r.food+" 💊+"+r.med+"<br>"+
        "<span style='color:#8affd0'>"+unL+"</span><br>无尽 第"+(S.endlessTier||0)+" 层已突破 · 下一层敌人更强";
    }
  } else {
    S.food=Math.max(0,S.food-2);
    let retryBtn="";
    if(S.mode!=="campaign"){
      S.crew.forEach(c=>{ if(c.hp<1||c.dead){ c.dead=false; c.hp=CREO_DEF[c.type].hp; c.mor=Math.max(30,c.mor); } c.ammo=c.ammo||defaultAmmo(c.type); });
      retryBtn="<button id='btnRetry' style='margin-top:8px;padding:6px 14px;background:#3a6a8a;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px'>休整再战</button>";
    }
    // 重写 box.innerHTML: 自动清掉上一局残留的"休整再战"按钮(主线战败 retryBtn 为空 → 按钮随之消失)
    box.innerHTML="<h2 class='lose'>❌ "+msg+"</h2>补给消耗🍖-2金币未损失,回营地休整"+(S.mode!=="campaign"?"(可再战)":"")+"<br>"+retryBtn+
      "提示: 用🧨/🚀控制战场节奏,医疗站治疗存活士兵;"+(S.mode==="campaign"?" 士兵死亡本局不可用,需重开":"");
  }
  document.getElementById("resultOverlay").style.display="flex";
  setTimeout(()=>{ document.getElementById("resultOverlay").style.display="none"; refreshHud(); renderCamp(); },1800);
  // 立即回营并重绘: 避免"胜利浮层消失时画面还停在战场, 僵尸凭空没了"的视觉 bug
  // (1800ms 后再次 renderCamp 重绘无副作用)
  refreshHud(); renderCamp();
  // 战败"休整再战"按钮: 仅独立模式(保卫/无尽)显示 — 战败已把 S.crew 休整满血(见上方),
  // 点按钮直接 deploy() 按原难度层/波次再战; 主线战败按钮不渲染(innerHTML 清空), 需医疗站或 ↺ 重开
  if(S.mode!=="campaign"){
    const retryBtnEl=document.getElementById("btnRetry");
    if(retryBtnEl) retryBtnEl.onclick=()=>{ document.getElementById("resultOverlay").style.display="none"; deploy(); };
  }
  // 战后士兵状态回写: 存活者恢复 HP/士气, 阵亡者保持 dead=true(医疗站不再复活, 需重开)
  soldiers.forEach(s=>{ const c=s.crewRef; if(c){ if(s.alive){ c.hp=Math.max(1,Math.min(CREO_DEF[c.type].hp,s.hp)); c.mor=Math.max(20,c.mor*(win?1:0.7)); } } });
  save();
}
/* ==================== 画布渲染 ==================== */
let last=0;
function loop(t){
  const dt=Math.min(0.05,(t-last)/1000||0); last=t;
  if(inBattle&&!paused){ updateBattle(dt); }
  render(dt);
  requestAnimationFrame(loop);
}
function render(dt){
  const ctx=cv.getContext("2d");
  ctx.clearRect(0,0,VIEW_W,VIEW_H);
  const isBattle=(view==="battle"&&inBattle);
  // 摄像机: 战斗视角平移世界, 营地视角居中
  const ox=isBattle?camX:0, oy=isBattle?camY:0;
  // 像素风关键: 关闭平滑, 放大 sprite 时保持锐利
  ctx.imageSmoothingEnabled=false;
  // 摄像机偏移取整到像素(消除 0.5px 级亚像素抖动, 防地皮横向"闪")
  const oxi=Math.round(ox), oyI=Math.round(oy);
  ctx.save();
  ctx.translate(-oxi,-oyI);
  // 背景像素地皮(战斗 按关卡地图 bg / 营地暖土色), 世界坐标平铺(48px 周期)
  {
    const gtex=(isBattle)?((SPR.bg&&SPR.bg[mCurBg])||groundTex):groundTexCamp;
    const T=48;
    const wx0=Math.max(0,Math.floor(oxi/T)*T), wy0=Math.max(0,Math.floor(oyI/T)*T);
    if(gtex){
      for(let wy=wy0;wy<oyI+VIEW_H;wy+=T){
        for(let wx=wx0;wx<oxi+VIEW_W;wx+=T){
          // 裁剪到可见区(防越界; 越界的 tile 画在 canvas 外 → 黑底+绿带 bug)
          const x0=Math.max(wx,oxi), y0=Math.max(wy,oyI);
          const x1=Math.min(wx+T,oxi+VIEW_W), y1=Math.min(wy+T,oyI+VIEW_H);
          if(x1<=x0||y1<=y0) continue;
          ctx.drawImage(gtex, x0, y0, x1-x0, y1-y0);
        }
      }
    } else { ctx.fillStyle="#0a1410"; ctx.fillRect(oxi,oyI,VIEW_W,VIEW_H); }
  }
  ctx.strokeStyle="rgba(47,79,58,.35)"; ctx.lineWidth=1;
  if(isBattle){
    // 战场网格按世界坐标绘制(仅绘制可见区, 提升性能)
    const x0=Math.max(0,Math.floor(ox/CELL)*CELL), x1=Math.min(WORLD_W,ox+VIEW_W);
    const y0=Math.max(0,Math.floor(oy/CELL)*CELL), y1=Math.min(WORLD_H,oy+VIEW_H);
    for(let x=x0;x<=x1;x+=CELL){ ctx.beginPath(); ctx.moveTo(x,oy); ctx.lineTo(x,y1); ctx.stroke(); }
    for(let y=y0;y<=y1;y+=CELL){ ctx.beginPath(); ctx.moveTo(ox,y); ctx.lineTo(ox+VIEW_W,y); ctx.stroke(); }
    // 出生区(世界左侧)
    if(ox<3*CELL){ ctx.fillStyle="rgba(63,140,95,.12)"; ctx.fillRect(0,0,3*CELL,VIEW_H); }
    // 右侧敌方区域标记
    if(ox+VIEW_W>WORLD_W-3*CELL){ ctx.fillStyle="rgba(140,50,50,.10)"; ctx.fillRect(WORLD_W-3*CELL,0,3*CELL,VIEW_H); }
  } else {
    // 营地网格
    for(let x=0;x<=VIEW_W;x+=CELL){ ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,VIEW_H); ctx.stroke(); }
    for(let y=0;y<=VIEW_H;y+=CELL){ ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(VIEW_W,y); ctx.stroke(); }
  }
  // 战场/营地装饰
  if(view==="battle"){
    // 战斗视角: 单位/平民在下方绘制
  } else {
    // 营地静态装饰: 建筑槽位 (与 bldLayout 同步, 保证点击命中)
    bldRects=bldLayout();
    bldRects.forEach(r=>{
      const b=BUILDINGS.find(x=>x.id===r.id);
      const lv=S.bld[b.id];
      const x=r.x,y=r.y;
      const sp=SPR.bld[b.id]?SPR.bld[b.id][lv]:null;
      if(sp){

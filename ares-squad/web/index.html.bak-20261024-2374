      ny=Math.max(camY,Math.min(camY+VIEW_H,ny));
      if(inBase){ nx=Math.max(BASE_SPAWN.x0,Math.min(BASE_SPAWN.x1,nx)); ny=Math.max(BASE_SPAWN.y0,Math.min(BASE_SPAWN.y1,ny)); }

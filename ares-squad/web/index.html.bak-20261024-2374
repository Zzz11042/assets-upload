    const aliveIdx=[];
    soldiers.forEach((s,i)=>{ if(s.alive)aliveIdx.push(i); });
    const fOff=FORMATIONS[formation].offsets(aliveIdx.length);
    aliveIdx.forEach((origIdx,ai)=>{
      const s=soldiers[origIdx];
      const off=fOff[ai]||{dx:0,dy:0};
      let tx=Math.max(camX+CELL,Math.min(camX+VIEW_W-CELL,mx+off.dx));
      let ty=Math.max(camY+CELL,Math.min(camY+VIEW_H-CELL,my+off.dy));
      if(inBase){ tx=Math.max(BASE_SPAWN.x0,Math.min(BASE_SPAWN.x1,tx)); ty=Math.max(BASE_SPAWN.y0,Math.min(BASE_SPAWN.y1,ty)); }
      s.tx=tx; s.ty=ty; s.target=null; s.cmdHold=3;   // 玩家移动指令: 3s 窗口内不"改派目标", 但到达位置后随时可开火
    });

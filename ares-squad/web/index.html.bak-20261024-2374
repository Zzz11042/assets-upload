  }
  // 点空地 → 全队移动(按当前队形排开, 钳制在镜头可视区内)
  {
    const mx0=Math.max(camX,Math.min(camX+VIEW_W,p.x));
    const my0=Math.max(camY,Math.min(camY+VIEW_H,p.y));
    const inBase=walls.length>0; // 保卫/无尽: 出生区封闭, 点场外 → 截断到出生区(守门口, 不追出去)
    const mx=inBase?Math.max(BASE_SPAWN.x0,Math.min(BASE_SPAWN.x1,mx0)):mx0;
    const my=inBase?Math.max(BASE_SPAWN.y0,Math.min(BASE_SPAWN.y1,my0)):my0;

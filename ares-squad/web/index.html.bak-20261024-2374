/* ==================== 像素美术引擎(星露谷/泰拉瑞亚风) ====================
   思路: 程序化像素 sprite —— 离屏 canvas 逐像素绘制小图(12x14),
   主 canvas 关闭平滑 + 整数倍放大, 保持像素锐利。每色 3~4 档明度,
   左上光源高光 / 右下阴影, 深色轮廓强调剪影。 */
const SPRITE_SCALE=3;
// 单位描边: 深墨青, 与深绿地皮(#3a5a3a)拉开反差, 贴地也剪影清晰(仿星露谷角色描边)
const OUTLINE="#0a1a14";
function pxCan(w,h){ const c=document.createElement("canvas"); c.width=w; c.height=h; return c; }
function pxDraw(g,w,h){ g.imageSmoothingEnabled=false; return g; }
function makeSprite(w,h,fn){
  const c=pxCan(w,h); const g=c.getContext("2d"); pxDraw(g,w,h);
  fn(g,(px,py,col)=>{ g.fillStyle=col; g.fillRect(px,py,1,1); });
  return c;
}
// 通用像素小人模板: 参数化头盔色/身体色/腿/武器
// 第 16 轮优化建模: 12×16 → 16×20, 增加头盔高光/护目镜/背包/枪托/靴钉/高光边缘
function makeSoldier(base,accent,weapon){
  return makeSprite(16,20,(g,px)=>{
    const c=OUTLINE;                  // 轮廓(深墨青, 与深绿地皮拉开反差)
    const skin="#e8c89a", skinD="#c8a878";
    const leg="#4a3a2a", legD="#3a2a1a";
    const boot="#2a2a2a", bootD="#1a1a1a";
    const hl="#ffffff", hlA="rgba(255,255,255,.55)";  // 高光
    // 头盔(带高光 + 护目镜槽)
    px(5,0,c);px(6,0,c);px(7,0,c);px(8,0,c);px(9,0,c);px(10,0,c);
    px(4,1,c);px(5,1,accent);px(6,1,accent);px(7,1,accent);px(8,1,accent);px(9,1,accent);px(10,1,accent);px(11,1,c);
    px(4,2,c);px(5,2,accent);px(6,2,base);px(7,2,base);px(8,2,base);px(9,2,base);px(10,2,accent);px(11,2,c);
    px(4,3,c);px(5,3,base);px(6,3,skin);px(7,3,skin);px(8,3,skinD);px(9,3,skinD);px(10,3,base);px(11,3,c);
    // 护目镜(深色镜片 + 左上高光)
    px(6,4,c);px(7,4,"#2a3a3a");px(8,4,"#2a3a3a");px(9,4,"#2a3a3a");px(10,4,c);
    px(7,4,hlA);
    px(5,5,c);px(6,5,skinD);px(7,5,skinD);px(8,5,skin);px(9,5,skinD);px(10,5,c);
    // 躯干(背包 + 胸甲 + 腰带)
    px(4,6,c);px(5,6,base);px(6,6,base);px(7,6,base);px(8,6,base);px(9,6,base);px(10,6,base);px(11,6,c);
    px(3,7,c);px(4,7,legD);px(5,7,base);px(6,7,base);px(7,7,accent);px(8,7,accent);px(9,7,base);px(10,7,base);px(11,7,legD);px(12,7,c);  // 背包侧片
    px(3,8,c);px(4,8,legD);px(5,8,base);px(6,8,base);px(7,8,base);px(8,8,base);px(9,8,base);px(10,8,base);px(11,8,legD);px(12,8,c);
    // 腰带
    px(4,9,c);px(5,9,bootD);px(6,9,bootD);px(7,9,boot);px(8,9,boot);px(9,9,bootD);px(10,9,bootD);px(11,9,c);
    // 手臂(持枪姿态) + 武器
    px(3,7,c);px(12,7,c);
    px(3,8,c);px(12,8,c);
    if(weapon==="gun"){ px(10,7,boot);px(11,7,boot);px(12,7,bootD);px(13,7,bootD);
      px(10,8,boot);px(11,8,boot);  // 枪管下段
      px(11,6,boot);  // 机匣上沿
    }
    if(weapon==="snipe"){ px(10,6,boot);px(11,6,boot);px(12,6,boot);px(13,6,boot);px(14,6,bootD);
      px(11,8,boot);px(12,8,bootD);  // 长栓
      px(9,5,hlA);  // 瞄准镜高光
    }
    // 腿(不对称, 行军姿态)
    px(5,10,c);px(6,10,leg);px(7,10,leg);px(8,10,c);
    px(5,11,c);px(6,11,leg);px(7,11,leg);px(8,11,c);
    px(5,12,c);px(6,12,legD);px(7,12,legD);px(8,12,c);
    // 靴(带钉)
    px(5,13,c);px(6,13,boot);px(7,13,boot);px(8,13,c);
    px(6,14,bootD);px(7,14,bootD);
    // 左上光源: 头盔 + 胸甲左上高光
    px(5,1,hl);
    px(5,6,hlA);
  });
}

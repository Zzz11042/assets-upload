// 兵种默认弹药(主武器按 AMMO_CAP 满配, 副手枪不限量)
function defaultAmmo(type){
  const d=CREO_DEF[type]; const main=d.wep[0];
  const ammo={};
  ["m9","mg","snipe","medgun","egun","shotgun","taser","rocket","gauss"].forEach(k=>{ ammo[k]=0; });
  if(main!=="pistol") ammo[main]=AMMO_CAP[main]||0;
  return ammo;
}
// 解锁规则: 开局 1 人, 过 2 关解锁 1 职业(M2/M4/M6/M8, 共 5 职业), 兵营可升至 15 级每级 +1 上限(最高 15 人)
function unlockedCrewCount(mission){
  return 1 + Math.min(4, Math.floor((Math.max(1,mission)-1)/2));
}
// 按兵营上限补一名职业兵(类型循环 0..4), 兵营每升 1 级 +1 上限(最高 15 人)
function addCrew(idx){
  const t=[0,1,2,3,4][idx%5]||0;
  if(S.crew.length>=15) return;
  S.crew.push({type:t,hp:CREO_DEF[t].hp,mor:100,wep:CREO_DEF[t].wep[0],ammo:defaultAmmo(t),dead:false});
}
function ensureCrew(){
  const n=unlockedCrewCount(S.mission);
  const TYPE=[0,1,2,3,4];
  while(S.crew.length<n){
    const t=TYPE[S.crew.length];
    S.crew.push({type:t,hp:CREO_DEF[t].hp,mor:100,wep:CREO_DEF[t].wep[0],ammo:defaultAmmo(t),dead:false});
  }
  // 老存档兼容: 补齐 dead 字段 + 主武器按职业固定 + 新弹药键(rocket/gauss)
  S.crew.forEach(c=>{
    if(c.dead===undefined)c.dead=false;
    if(!c.ammo)c.ammo=defaultAmmo(c.type);
    ["m9","mg","snipe","medgun","egun","shotgun","taser","rocket","gauss"].forEach(k=>{ if(c.ammo[k]===undefined)c.ammo[k]=0; });
    const d=CREO_DEF[c.type];
    if(!d.wep.includes(c.wep)) c.wep=d.wep[0];
  });
  return S.crew;
}
// 兼容老存档: 补齐 wep/ammo(没有的话默认职业主武器+满弹药)
function normalizeState(st){
  if(!st.crew)return st;
  st.crew.forEach(c=>{
    const d=CREO_DEF[c.type]||CREO_DEF[0];
    if(!c.wep)c.wep=d.wep[0];
    if(!d.wep.includes(c.wep))c.wep=d.wep[0];
    if(!c.ammo)c.ammo=defaultAmmo(c.type);
    ["m9","mg","snipe","medgun","egun","shotgun","taser"].forEach(k=>{ if(c.ammo[k]===undefined)c.ammo[k]=0; });
    if(c.dead===undefined)c.dead=false;
  });
  if(st.weapon===undefined)st.weapon="m9";
  // 老存档裁剪: 超出当前解锁数的旧兵删掉
  const n=unlockedCrewCount(st.mission||1);
  if(st.crew.length>n)st.crew.length=n;
  return st;
}

  city:  {c1:"#2a3a30",c2:"#223028",c3:"#344a3a",deco:"rubble",decoCol:"#5a5a52"},   // 城市废墟: 灰绿地+碎石
  road:  {c1:"#3a3830",c2:"#343228",c3:"#424038",deco:"road",  decoCol:"#9a968a"},   // 公路: 低对比土黄+暗色路面线(静态不闪)
  lab:   {c1:"#2a3a42",c2:"#203038",c3:"#3a5a66",deco:"tiles", decoCol:"#3a4a54"},   // 研究所: 冷蓝瓷砖(低对比, 静态不闪)
  tunnel:{c1:"#222a24",c2:"#181f1a",c3:"#2e3a30",deco:"pipe",  decoCol:"#6a5a4a"},   // 地下管廊: 暗+管道
  ruin:  {c1:"#3a3a2a",c2:"#2e2e22",c3:"#4a4a36",deco:"rubble",decoCol:"#8a8a7a"}    // 废墟: 沙土+瓦砾
};
function makeGroundBg(def){
  const P=48;
  const c1=def.c1, c2=def.c2, c3=def.c3;
  return makeSprite(P,P,(g,px)=>{
    for(let y=0;y<P;y++)for(let x=0;x<P;x++){
      const n=((x%12)*7+(y%12)*13+((x*y)%5))%7;
      let col=c1;
      if(n===0)col=c2; else if(n===2)col=c3; else if(n===5)col=c2;
      px(x,y,col);
    }
    // 场景装饰(确定性布局, 12px 周期平铺时不重复错位)
    const dc=def.decoCol;
    if(def.deco==="rubble"){ // 碎石/瓦砾
      for(let i=0;i<18;i++){ const x=(i*17+3)%P,y=(i*29+5)%P;
        px(x,y,dc); if(i%3===0)px(x+1,y,dc); if(i%5===0)px(x,y+1,dc); }
    } else if(def.deco==="road"){ // 路面双虚线: 整 tile 只画 12px 周期的完整短段(0,10)+12, 接缝零色差 → 无横向闪
      for(let x=0;x<P;x+=12){ px(x,10,dc); px(x+1,10,dc); px(x+2,10,dc); }
      for(let x=0;x<P;x+=12){ px(x,22,dc); px(x+1,22,dc); }
      for(let x=0;x<P;x+=12){ px(x,34,dc); px(x+1,34,dc); px(x+2,34,dc); }
    } else if(def.deco==="tiles"){ // 瓷砖缝(冷色网格线)
      for(let x=0;x<P;x+=12){ px(x,0,dc); }
      for(let y=0;y<P;y+=12){ px(0,y,dc); }
    } else if(def.deco==="pipe"){ // 管道(纵向条纹)
      for(let y=0;y<P;y++){ px(6,y,dc); px(7,y,dc); px(30,y,dc); px(31,y,dc); }
    }
  });
}
function makeGround(col1,col2,col3){
  const P=48;
  return makeSprite(P,P,(g,px)=>{
    for(let y=0;y<P;y++)for(let x=0;x<P;x++){
      const n=((x%12)*7+(y%12)*13+((x*y)%5))%7;
      let col=col1;
      if(n===0)col=col2; else if(n===2)col=col3; else if(n===5)col=col2;
      px(x,y,col);
    }
    for(let i=0;i<24;i++){ const x=(i*17+3)%P,y=(i*29+5)%P; px(x,y,col2); }
  });
}

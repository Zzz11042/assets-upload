    sporeZones.forEach(z=>{
      if(!inView(z.x,z.y))return;
      ctx.fillStyle="rgba(168,216,74,"+(Math.min(1,z.ttl/5)*0.35)+")";
      ctx.beginPath(); ctx.ellipse(z.x,z.y,z.r,z.r*0.5,0,0,Math.PI*2); ctx.fill();
      ctx.strokeStyle="rgba(168,216,74,"+(Math.min(1,z.ttl/5)*0.5)+")"; ctx.lineWidth=1;
      ctx.beginPath(); ctx.arc(z.x,z.y,z.r,0,Math.PI*2); ctx.stroke();
    });
    // 免费弹药补给站(每关 1 个): 橙色弹药箱 + 射程圈, 士兵进入 90px 半径补满主武器弹仓
    ammoStations.forEach(st=>{
      if(!inView(st.x,st.y))return;
      ctx.save(); ctx.globalAlpha=0.2; ctx.fillStyle="#8affd0";
      ctx.beginPath(); ctx.arc(st.x,st.y,st.r,0,Math.PI*2); ctx.fill(); ctx.restore();
      ctx.strokeStyle="rgba(138,255,208,0.4)"; ctx.lineWidth=2; ctx.setLineDash([6,4]);
      ctx.beginPath(); ctx.arc(st.x,st.y,st.r,0,Math.PI*2); ctx.stroke(); ctx.setLineDash([]);
      if(SPR.ammoStation) ctx.drawImage(SPR.ammoStation, st.x-27, st.y-24, 54, 48);
      // 保卫/无尽: 基地补给点带保护罩(士兵在其 90px 内不会被近战/酸弹打)
      if(st.protected){
        ctx.strokeStyle="rgba(138,255,208,.55)"; ctx.lineWidth=3; ctx.setLineDash([10,6]);
        ctx.beginPath(); ctx.arc(st.x,st.y,st.r,0,Math.PI*2); ctx.stroke(); ctx.setLineDash([]);
        ctx.fillStyle="#8affd0"; ctx.font="bold 10px monospace"; ctx.textAlign="center";
        ctx.fillText("🛡 保护罩", st.x, st.y+st.r+12);
      }
      ctx.fillStyle="#8affd0"; ctx.font="bold 11px monospace"; ctx.textAlign="center";
      ctx.fillText("🔫 免费补给点", st.x, st.y-30);
    });
    // 围墙(保卫/无尽模式): 灰色砖墙 + 3 段渐变血条 + 残骸; 士兵在围墙 60px 内可就地补弹药(围墙附近补给)
    walls.forEach(wl=>{
      const inV2=(x,y)=>x>=camX&&x<=camX+VIEW_W&&y>=camY&&y<=camY+VIEW_H;
      if(!inV2(wl.x,wl.y)&&!inV2(wl.x+wl.w,wl.y+wl.h))return;
      if(!wl.alive){
        // 残骸(墙塌后): 灰色碎砖 + 烟尘
        ctx.fillStyle="#3a4038";
        ctx.fillRect(wl.x+4,wl.y+4,wl.w-8,wl.h-8);
        ctx.fillStyle="#4a5048";
        for(let i=0;i<5;i++){
          const bx=wl.x+8+(i*(wl.w-16)/4), by=wl.y+wl.h/2+((i%2)*8-4);
          ctx.fillRect(bx,by,Math.min(12,wl.w/3),6);
        }
        ctx.fillStyle="rgba(90,90,90,.35)";
        ctx.beginPath(); ctx.arc(wl.x+wl.w/2,wl.y+wl.h/2,Math.max(wl.w,wl.h)*0.4,0,Math.PI*2); ctx.fill();
        ctx.fillStyle="#5a6a5a"; ctx.font="bold 9px monospace"; ctx.textAlign="center";
        ctx.fillText("残骸",wl.x+wl.w/2,wl.y+wl.h/2+3);
        return;
      }
      ctx.fillStyle="#5a6a5a";
      ctx.fillRect(wl.x,wl.y,wl.w,wl.h);
      ctx.strokeStyle="#8a9a8a"; ctx.lineWidth=2;
      ctx.strokeRect(wl.x,wl.y,wl.w,wl.h);
      // 砖缝
      ctx.strokeStyle="rgba(40,50,40,.5)"; ctx.lineWidth=1;
      if(wl.w>wl.h){ for(let yy=wl.y+wl.h/2;yy<wl.y+wl.h;yy+=wl.h/2){ ctx.beginPath(); ctx.moveTo(wl.x,yy); ctx.lineTo(wl.x+wl.w,yy); ctx.stroke(); } }
      else { for(let xx=wl.x+wl.w/2;xx<wl.x+wl.w;xx+=wl.w/2){ ctx.beginPath(); ctx.moveTo(xx,wl.y); ctx.lineTo(xx,wl.y+wl.h); ctx.stroke(); } }
      // 3 段渐变血条(绿>黄>红, 对应 50%/25%/0%)
      const hpPct=wl.hp/wl.maxHp;
      const barH=5;
      ctx.fillStyle="#1a1a2a"; ctx.fillRect(wl.x,wl.y-barH-3,wl.w,barH);
      const c=hpPct>0.5?"#6fbf6f":(hpPct>0.25?"#ffd75a":"#ff6f6f");
      ctx.fillStyle=c; ctx.fillRect(wl.x,wl.y-barH-3,wl.w*hpPct,barH);
      // 血条分段线
      ctx.strokeStyle="rgba(26,26,42,.8)"; ctx.lineWidth=1;
      ctx.beginPath(); ctx.moveTo(wl.x+wl.w*0.5,wl.y-barH-3); ctx.lineTo(wl.x+wl.w*0.5,wl.y+2); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(wl.x+wl.w*0.25,wl.y-barH-3); ctx.lineTo(wl.x+wl.w*0.25,wl.y+2); ctx.stroke();
      // 受击闪烁
      if(wl.flash>0){ ctx.fillStyle="rgba(255,215,90,"+(wl.flash*3)+")"; ctx.fillRect(wl.x,wl.y,wl.w,wl.h); }
      // 围墙附近(60px)可补弹区的标记
      ctx.fillStyle="rgba(138,255,208,.06)";
      ctx.fillRect(wl.x-20,wl.y-20,wl.w+40,wl.h+40);
    });
    // 哨戒机枪(防御任务): 绘制炮塔 sprite + 血条 + 射程圈(淡)
    turrets.forEach(tu=>{
      if(tu.hp<=0)return;
      if(!inView(tu.x,tu.y))return;
      ctx.strokeStyle="rgba(138,184,232,0.12)"; ctx.lineWidth=1;
      ctx.beginPath(); ctx.arc(tu.x,tu.y,tu.range,0,Math.PI*2); ctx.stroke();
      ctx.drawImage(SPR.turret, tu.x-20, tu.y-24, 40, 34);
      // 血条
      const hpPct=tu.hp/tu.maxHp;
      ctx.fillStyle="#1a1a2a"; ctx.fillRect(tu.x-16,tu.y-28,32,3);
      ctx.fillStyle=hpPct>0.5?"#8ab8e8":"#ffd75a"; ctx.fillRect(tu.x-16,tu.y-28,32*hpPct,3);
    });
    // 平民(战斗)
    if(civ&&inView(civ.x,civ.y)){
      shadow(civ.x,civ.y+2,36);
      if(SPR.civ) drawSprite(ctx,SPR.civ,civ.x-22,civ.y-29,44,56,0);
      hpBar(civ.x,civ.y,civ.hp,60,50);
    }
    // 调试开关(默认关): 4 角锚点 + 单位白点, 定位坐标问题用
    if(window.__DBG){
      ctx.fillStyle="#ff0000"; ctx.fillRect(ox+2,oy+2,12,12);
      ctx.fillStyle="#00ff00"; ctx.fillRect(ox+VIEW_W-14,oy+2,12,12);
      ctx.fillStyle="#0000ff"; ctx.fillRect(ox+2,oy+VIEW_H-14,12,12);
      ctx.fillStyle="#ffff00"; ctx.fillRect(ox+VIEW_W-14,oy+VIEW_H-14,12,12);
      ctx.fillStyle="#ffffff";
      soldiers.forEach(s=>{ if(s.alive) ctx.fillRect(s.x-2,s.y-2,4,4); });
      enemies.forEach(e=>{ if(e.alive) ctx.fillRect(e.x-2,e.y-2,4,4); });
    }
  } else {
    // 营地里士兵站立
    for(let i=0;i<3;i++){
      const x=(4+i*1.5)*CELL, y=VIEW_H-CELL*2.5;
      const sp=SPR.soldier[i];
      if(sp) ctx.drawImage(sp,x-18,y-24,36,42);
    }
  }
  // 特效
  fx.forEach(f=>{
    if(f.line){ if(!inView(f.x,f.y)&&!inView(f.tx,f.ty))return; ctx.strokeStyle=f.color; ctx.lineWidth=2; ctx.globalAlpha=Math.max(0,f.life/0.12); ctx.beginPath(); ctx.moveTo(f.x,f.y); ctx.lineTo(f.tx,f.ty); ctx.stroke(); ctx.globalAlpha=1; }
    else if(f.type==="acid"){
      // 投掷者酸弹: 抛物线飞行, 命中 30px 内 8 伤 + 3s 减速
      if(!inView(f.x,f.y))return;
      const p=Math.min(1,(f.age||0)/f.dur);
      f.x=f.sx+(f.tx-f.sx)*p; f.y=f.sy+(f.ty-f.sy)*p - 60*Math.sin(Math.PI*p); // 抛物线拱起
      ctx.fillStyle="#c8e04a"; ctx.beginPath(); ctx.arc(f.x,f.y,4,0,Math.PI*2); ctx.fill();
      ctx.strokeStyle="#c8e04a"; ctx.lineWidth=1; ctx.beginPath(); ctx.arc(f.x,f.y,7,0,Math.PI*2); ctx.stroke();
      if(p>=1){
        soldiers.forEach(s=>{ if(s.alive&&s.safeT<=0&&Math.hypot(s.x-f.tx,s.y-f.ty)<30){ s.hp-=8; s.slowT=Math.max(s.slowT||0,3); if(s.hp<1)s.hp=0; }});
        fx.push({x:f.tx,y:f.ty,life:0.4,color:"#c8e04a"});
        f.life=0;
      }
    }
    else if(f.type==="boom"){
      // 自爆兵爆炸: 橙色冲击波环(扩大+淡出)
      if(!inView(f.x,f.y))return;
      const p=1-Math.max(0,f.life/0.5);
      const r=(f.r||70)*p+10;
      ctx.strokeStyle="rgba(255,138,58,"+(1-p)*0.9+")"; ctx.lineWidth=4*(1-p)+1;
      ctx.beginPath(); ctx.arc(f.x,f.y,r,0,Math.PI*2); ctx.stroke();
      ctx.fillStyle="rgba(255,200,80,"+(1-p)*0.4+")";
      ctx.beginPath(); ctx.arc(f.x,f.y,r*0.7,0,Math.PI*2); ctx.fill();
    }
    else { if(!inView(f.x,f.y))return; ctx.fillStyle=f.color; ctx.globalAlpha=Math.max(0,f.life*2); ctx.fillRect(f.x-3,f.y-3,6,6); ctx.globalAlpha=1; f.x+=f.vx*dt; f.y+=f.vy*dt; }
  });
  // 酸弹年龄推进
  fx.forEach(f=>{ if(f.type==="acid"){ f.age+=dt; f.life-=dt; } });
  // 点击涟漪反馈(世界坐标)
  if(tapMarker){
    tapMarker.life-=dt;
    if(tapMarker.life<=0) tapMarker=null;
    else{
      const pr=20*(1-tapMarker.life/0.5)+8;
      ctx.strokeStyle="rgba(255,215,90,"+(tapMarker.life/0.5).toFixed(2)+")";
      ctx.lineWidth=2; ctx.beginPath(); ctx.arc(tapMarker.x,tapMarker.y,pr,0,Math.PI*2); ctx.stroke();
    }
  }
  // 目标准星
  if(view==="battle"){
    soldiers.forEach(s=>{
      if(!s.alive||!s.target||!s.target.alive) return;
      if(!inView(s.target.x,s.target.y))return;
      ctx.strokeStyle="rgba(255,111,111,.85)"; ctx.lineWidth=1.5;
      const tx=s.target.x, ty=s.target.y;
      ctx.beginPath(); ctx.arc(tx,ty,16,0,Math.PI*2); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(tx-20,ty); ctx.lineTo(tx-10,ty); ctx.moveTo(tx+10,ty); ctx.lineTo(tx+20,ty);
      ctx.moveTo(tx,ty-20); ctx.lineTo(tx,ty-10); ctx.moveTo(tx,ty+10); ctx.lineTo(tx,ty+20); ctx.stroke();
    });
    // 玩家指挥指示: 士兵脚下显示其朝向(玩家指令=蓝绿, 自动推进=灰)
    soldiers.forEach(s=>{
      if(!s.alive)return; if(!inView(s.x,s.y))return;
      ctx.strokeStyle=s.cmdHold>0?"rgba(80,200,255,.9)":"rgba(160,200,180,.5)";
      ctx.lineWidth=2;
      ctx.beginPath(); ctx.moveTo(s.x,s.y+16); ctx.lineTo(s.x,s.y+26); ctx.stroke();
    });
  }
  ctx.restore();   // 退出世界坐标
  // 小地图(战斗视角, 屏幕空间右上角)
  if(isBattle) drawMinimap(ctx);
  if(paused){ ctx.fillStyle="rgba(6,12,8,.6)"; ctx.fillRect(0,0,VIEW_W,VIEW_H); ctx.fillStyle="#ffd75a"; ctx.font="20px monospace"; ctx.textAlign="center"; ctx.fillText("⏸ 暂停",VIEW_W/2,VIEW_H/2); }
}
/* 小地图: 显示整个战场 + 摄像机框, 帮助玩家理解跟随视野 */
function drawMinimap(ctx){
  const mw=150, mh=Math.round(mw*WORLD_H/WORLD_W); // 按比例
  const mx=VIEW_W-mw-8, my=8;
  ctx.fillStyle="rgba(10,20,16,.75)"; ctx.fillRect(mx,my,mw,mh);
  ctx.strokeStyle="rgba(140,230,160,.5)"; ctx.lineWidth=1; ctx.strokeRect(mx,my,mw,mh);
  const sx=mw/WORLD_W, sy=mh/WORLD_H;
  // 敌人
  ctx.fillStyle="#ff6f6f";
  enemies.forEach(en=>{ if(!en.alive)return; ctx.fillRect(mx+en.x*sx-1,my+en.y*sy-1,3,3); });
  // 士兵
  ctx.fillStyle="#8ce6a0";
  soldiers.forEach(s=>{ if(!s.alive)return; ctx.fillRect(mx+s.x*sx-1,my+s.y*sy-1,3,3); });
  // 平民
  if(civ&&civ.hp>0){ ctx.fillStyle="#ffe8a0"; ctx.fillRect(mx+civ.x*sx-1,my+civ.y*sy-1,4,4); }
  // 摄像机视野框
  ctx.strokeStyle="#ffd75a"; ctx.lineWidth=1;
  ctx.strokeRect(mx+camX*sx,my+camY*sy,VIEW_W*sx,VIEW_H*sy);
}
function drawCampStatic(){ /* 渲染已并入主循环 */ }
/* ==================== 缩放画布 ==================== */
function fitCanvas(){
  // 关键: 同步 canvas 内部分辨率(世界坐标 960x560), 否则单位/网格全画在默认 300x150 坐标系外 → 看不到士兵
  if(cv.width!==VIEW_W||cv.height!==VIEW_H){ cv.width=VIEW_W; cv.height=VIEW_H; }
  const wrap=cv.parentElement;
  const r=wrap.getBoundingClientRect();
  if(r.width<10||r.height<10) return;
  // 像素风: 取"不溢出容器前提下最大的 0.5 倍数整数缩放"(0.5/0.25...), 保持像素锐利;
  // 桌面宽视口下 0.5 整数缩放, 手机窄屏 0.25, 绝不再出 0.52 这类糊化非整数倍。
  const raw=Math.min(r.width/VIEW_W, r.height/VIEW_H);
  const scale=Math.max(0.25, Math.min(1, Math.floor(raw*2)/2));
  cv.style.setProperty("width",Math.floor(VIEW_W*scale)+"px","important");
  cv.style.setProperty("height",Math.floor(VIEW_H*scale)+"px","important");
}
window.addEventListener("resize",fitCanvas);
window.addEventListener("orientationchange",()=>setTimeout(fitCanvas,200));
// 首次布局后再校准一次(确保 rAF 启动时画布尺寸已定)
if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",()=>setTimeout(fitCanvas,0));
else setTimeout(fitCanvas,0);
/* ==================== 按钮 ==================== */
document.getElementById("btnDeploy").onclick=deploy;
document.getElementById("btnHeal").onclick=()=>{ };
document.getElementById("btnGrenade").onclick=()=>useSkill("grenade");
document.getElementById("btnRacket").onclick=()=>useSkill("racket");
document.getElementById("btnFormation").onclick=()=>{ if(inBattle&&!paused) cycleFormation(); };
document.getElementById("btnPause").onclick=()=>{ paused=!paused; document.getElementById("btnPause").textContent=paused?"▶":"⏸"; };
document.getElementById("btnSave").onclick=save;
document.getElementById("btnReset").onclick=()=>{ if(confirm("确定重开?存档将清除")) resetAll(); };
document.getElementById("btnStart").onclick=()=>{ document.getElementById("onboard").style.display="none"; fitCanvas(); const g=offlineGain(); if(g>0) toast("离线"+g+"小时资源已结算"); renderCamp(); requestAnimationFrame(loop); };
/* 医疗站治疗快捷键(营地层点击士兵) 简化为自动 */
/* ==================== 启动 ==================== */
S=newState(); load(); fitCanvas();
if(!localStorage.getItem(LS_KEY)){ document.getElementById("onboard").style.display="flex"; }
else { document.getElementById("onboard").style.display="none"; const g=offlineGain(); if(g>0) setTimeout(()=>toast("离线"+g+"小时资源已结算"),300); renderCamp(); requestAnimationFrame(loop); }
// 兜底: onboard 层绝不进入渲染循环, 若误显示直接隐藏(防"进游戏被遮罩挡住")
setTimeout(()=>{ document.getElementById("onboard").style.display="none"; },1500);
/* ==================== 自动化/调试钩子 ==================== */
// __gt: 暴露顶层 let 供 headless 测试读取(绕过 let 作用域)
window.__gt=()=>({inBattle,view,paused,mission:S.mission,win:S.won,gold:Math.floor(S.gold),
  part:Math.floor(S.part),food:S.food,med:S.med,nsoldiers:soldiers.length,nenemies:enemies.length,
  crew:S.crew.length,camX:Math.round(camX),camY:Math.round(camY),
  soldiers:soldiers.map(s=>({x:Math.round(s.x),y:Math.round(s.y),hp:s.hp,alive:s.alive})),
  enemies:enemies.map(e=>({t:e.t,x:Math.round(e.x),y:Math.round(e.y),hp:e.hp,alive:e.alive}))});
// __gtStep(ms): 手动推进逻辑+渲染(绕过 rAF 节流), 自动化验证用
window.__gtStep=(ms)=>{ const dt=Math.min(0.05,(ms||16)/1000); last=Date.now();
  if(inBattle&&!paused) updateBattle(dt);
  render(dt); return window.__gt(); };
</script>

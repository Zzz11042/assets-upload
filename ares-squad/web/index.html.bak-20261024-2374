    if(civ&&civ.hp>0){ civ.tx=Math.max(camX+CELL,Math.min(camX+VIEW_W-CELL,mx0)); civ.ty=Math.max(camY+CELL,Math.min(camY+VIEW_H-CELL,my0)); }

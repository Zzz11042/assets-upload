function cycleFormation(){
  const keys=Object.keys(FORMATIONS);
  const i=keys.indexOf(formation);
  formation=keys[(i+1)%keys.length];
  const f=FORMATIONS[formation];
  const btn=document.getElementById("btnFormation");
  if(btn){ btn.textContent=f.icon+" "+f.nm; btn.title=f.desc; }
  toast("队形: "+f.nm+" — "+f.desc);
  // 立即按新队形对当前"移动目标"重排(若已在移动中)
  if(inBattle){
    const alive=soldiers.filter(s=>s.alive);
    const offsets=f.offsets(alive.length);
    if(alive.length>0){
      // 以最近一个有移动目标的士兵为锚点, 全队按新队形重排
      const anchor=alive.find(s=>s.tx!=null)||alive[0];
      const ax=anchor.tx!=null?anchor.tx:anchor.x, ay=anchor.ty!=null?anchor.ty:anchor.y;
      alive.forEach((s,ai)=>{
        const off=offsets[ai]||{dx:0,dy:0};
        let tx=Math.max(camX+CELL,Math.min(camX+VIEW_W-CELL,ax+off.dx));
        let ty=Math.max(camY+CELL,Math.min(camY+VIEW_H-CELL,ay+off.dy));
        if(walls.length>0){ tx=Math.max(BASE_SPAWN.x0,Math.min(BASE_SPAWN.x1,tx)); ty=Math.max(BASE_SPAWN.y0,Math.min(BASE_SPAWN.y1,ty)); }  // 出生区封闭
        s.tx=tx;
        s.ty=ty;
        s.cmdHold=3;   // 3s 窗口, 期间不被自动推进覆盖
      });
      // 护送关: 人质也听玩家/队形指挥, 目标钳制在镜头内(不出屏)
      if(civ&&civ.hp>0){ civ.tx=civ.ty=null; }
    }
  }
  return formation;
}
function onBattleTap(e){

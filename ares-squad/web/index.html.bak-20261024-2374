function startDefenseMode(){
  // 构造一个"保卫模式"任务对象(非 MISSIONS, 独立模式)
  const wave=S.defWave||0;
  const d=defenseWave(wave);
  const tierMult=(S.mode==="endless")?(1+(S.endlessTier||0)*0.3):1;
  const hpMul=d.hpMul*tierMult;
  // 同时 50+ 只 / 总数 500+ 只; 按难度递增混入更强敌人
  const groups=[
    {t:"walker",n:Math.round(d.simultaneous*0.5),r:[5,10]},
    {t:"fatty",n:Math.round(d.simultaneous*0.25),r:[5,12]},
    {t:"crawler",n:Math.round(d.simultaneous*0.25),r:[5,10]},
  ];
  if(wave>=1||tierMult>1){ groups.push({t:"screamer",n:4+wave*2,r:[6,6]}); }
  if(wave>=2||tierMult>1.5){ groups.push({t:"thrower",n:4+wave*2,r:[8,4]}); }
  if(wave>=3||tierMult>2){ groups.push({t:"tank",n:3+wave*2,r:[8,4]}); }
  if(wave>=4||tierMult>2.5){ groups.push({t:"king",n:1+Math.floor(wave/2),r:[12,3]}); }
  // 第 18 轮: 自爆兵(高速冲脸引爆) + 空降兵(伞降突袭)
  if(wave>=2||tierMult>1.5){ groups.push({t:"boomer",n:3+wave,r:[6,10]}); }
  if(wave>=5||tierMult>3){ groups.push({t:"dropper",n:2+Math.floor(wave/2),r:[5,10]}); }
  // 无尽模式: 按层混入"变异强化体"(用 king 但 hp×层)
  const enemies=groups.map(g=>({t:g.t,n:Math.max(1,Math.round(g.n)),r:g.r}));
  // 保底总数 ≥500: 基础组不足则用 walker 补齐(与 startBattle 二次保底一致, 双保险)
  let baseN=0; enemies.forEach(g=>{ baseN+=g.n; });
  if(baseN<d.total){ enemies.push({t:"walker",n:Math.max(0,d.total-baseN),r:[5,10]}); }
  return {
    id:"def_"+wave, nm:(S.mode==="endless"?"无尽 第"+(S.endlessTier+1)+" 层":"保卫战 第"+(wave+1)+" 波"),
    type:"defend", mode:S.mode, bg:"city",
    desc:"守住基地围墙, 尸潮 "+d.simultaneous+" 同时 / "+d.total+" 总数",
    enemies, defend:0, totalSpawn:d.total, simultaneous:d.simultaneous, hpMul,
    turrets:[{n:3,name:"哨戒机枪"}], reward:{gold:0,part:0,food:0,med:0}, boss:wave>=4
  };
}

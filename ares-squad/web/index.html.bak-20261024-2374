  if(hit){
    const inBase=walls.length>0; // 保卫/无尽: 围墙封闭出生区, 士兵占位不跑出出生区
    soldiers.forEach((s,i)=>{
      if(!s.alive) return;
      s.target=hit;
      // 集火时: 每个士兵按自身射程在目标周围占位(保持梯队, 避免重叠), 钳制在镜头可视区内
      const d=CREO_DEF[s.type];

        ctx.fillText("⚡",en.x,en.y-(shh||56)*0.5-12);
      }
      // 空降兵伞降中: 飘浮(带降落伞)
      if(en.flying){
        const bob=Math.sin((en.tgt||0)*4+en.x)*4;
        ctx.drawImage(SPR.zombie.dropper||SPR.zombie.walker,en.x-24,en.y-shh/2-30+bob,48,shh);
